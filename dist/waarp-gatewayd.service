[Unit]
Description=Waarp Gateway server
Documentation=https://doc.waarp.org/waarp-gateway/latest/fr/

[Service]
Type=simple
User=waarp
Group=waarp
WorkingDirectory=/var/lib/waarp-gateway
ExecStart=/bin/sh -c 'PATH=/usr/libexec/waarp-gateway:/usr/lib/waarp-gateway:$PATH exec /usr/bin/waarp-gatewayd server -c /etc/waarp-gateway/gatewayd.ini'
Restart=on-failure

[Install]
WantedBy=multi-user.target

