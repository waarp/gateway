<!-- Task description -->
<p class="task-description">{{ .Text.description }}</p>

<!-- Partner (required) -->
{{ template "textInputRow" dict
    "label" .Text.partner
    "tooltip" .Text.partnerTooltip
    "fieldName" "partner"
    "fieldType" "text"
    "value" .Task.Args.partner
    "placeholder" .Text.partnerPlaceholder
}}

<!-- Account (required) -->
{{ template "textInputRow" dict
    "label" .Text.account
    "tooltip" .Text.accountTooltip
    "fieldName" "account"
    "fieldType" "text"
    "value" .Task.Args.account
    "placeholder" .Text.accountPlaceholder
}}

<!-- Client (required) -->
{{ template "textInputRow" dict
    "label" .Text.client
    "tooltip" .Text.clientTooltip
    "fieldName" "client"
    "fieldType" "text"
    "value" .Task.Args.client
    "placeholder" .Text.clientPlaceholder
}}

<!-- Message content (optional) -->
{{ template "textInputRow" dict
    "label" .Text.message
    "tooltip" .Text.messageTooltip
    "fieldName" "message"
    "fieldType" "text"
    "value" .Task.Args.message
    "placeholder" .Text.messagePlaceholder
    "optional" true
}}

