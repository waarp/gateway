{{/* Partials shared by the screens that configure a protocol (local servers, local clients, remote partners): a
     form field, the choice of the protocol (the family and the TLS checkbox: TLS is an attribute at the screen,
     Driss, 2026-10-19), the cards of options by family and the TLS card. Data: the protoform.Form prepared by the
     handler. The cards of every family are rendered; the family select (data-switch) shows the one of its value and
     the TLS checkbox (data-switch="tls") the TLS card; without JavaScript every block is visible and the server
     reads the block of the chosen protocol only. */ -}}

{{/* proto/field: an input with its label, hint or error. ID, Label, Req, F ({Value, Error}), Hint, Short, Code; Num
     makes it a number field (browser arrows to go up and down, typing still possible) with Min and Max. */ -}}
{{ define "proto/field" -}}
<div class="w-field{{ if .Short }} w-field--short{{ end }}{{ if .F.Error }} is-invalid{{ end }}">
  <label class="w-field__label" for="{{ .ID }}">{{ .Label }}{{ if .Req }} <span class="w-field__req" aria-hidden="true">*</span>{{ else if .Code }} <span class="w-field__opt"><code class="w-code">{{ .Code }}</code></span>{{ else }} <span class="w-field__opt">{{ t "form.optional" }}</span>{{ end }}</label>
  <input class="w-input" id="{{ .ID }}" name="{{ .ID }}" value="{{ .F.Value }}"{{ if .Req }} required{{ end }}{{ if .Num }} type="number" inputmode="numeric" step="1"{{ with .Min }} min="{{ . }}"{{ end }}{{ with .Max }} max="{{ . }}"{{ end }}{{ end }}{{ if .F.Error }} aria-invalid="true" aria-describedby="{{ .ID }}-e"{{ else if .Hint }} aria-describedby="{{ .ID }}-h"{{ end }}>
  {{ if .F.Error }}<span class="w-field__error" id="{{ .ID }}-e">{{ icon "triangle" }} {{ .F.Error }}</span>{{ else if .Hint }}<span class="w-field__hint" id="{{ .ID }}-h">{{ .Hint }}</span>{{ end }}
</div>
{{- end }}

{{/* proto/choice: the family select and the TLS checkbox, protoform.ChoiceView. The checkbox sits in a fieldset shown
     for the families that have a TLS variant: hidden (and disabled) for the others, it reads "off". */ -}}
{{ define "proto/choice" -}}
<div class="w-field{{ if .Error }} is-invalid{{ end }}">
  <label class="w-field__label" for="protocol">{{ t "proto.label" }} <span class="w-field__req" aria-hidden="true">*</span></label>
  <select class="w-select" id="protocol" name="protocol" required data-switch aria-describedby="protocol-h"{{ if .Error }} aria-invalid="true"{{ end }}>
    <option value=""{{ if .None }} selected{{ end }}>{{ t "proto.choose" }}</option>
    {{ range .Families }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}
  </select>
  {{ if .Error }}<span class="w-field__error" id="protocol-h">{{ icon "triangle" }} {{ .Error }}</span>{{ else }}<span class="w-field__hint" id="protocol-h">{{ t "proto.choose_hint" }}</span>{{ end }}
</div>
<fieldset class="w-fieldset proto-tls" data-case="{{ .TLSCases }}">
  <label class="w-check"><input type="checkbox" id="tls" name="tls" value="1" data-switch="tls" aria-describedby="tls-h"{{ if .TLS }} checked{{ end }}> <span>{{ t "proto.tls" }}</span></label>
  <span class="w-field__hint" id="tls-h">{{ t "proto.tls_hint" }}</span>
</fieldset>
{{- end }}

{{/* proto/options: one card per family that has options, then the TLS card; protoform.Form. */ -}}
{{ define "proto/options" -}}
{{ range .Families }}{{ if .HasOptions }}
<div class="w-card" data-case="{{ .Key }}">
  <fieldset class="w-fieldset w-fieldset--wide">
    <legend class="w-card__title">{{ t "proto.options" "protocol" .Label }}</legend>
    {{ with .Note }}<p class="w-form__note proto-note">{{ . }}</p>{{ end }}
    {{ template "proto/block" .Plain }}
    {{ if or .TLS.Fields .TLS.Checks .TLS.Lists }}<fieldset class="w-fieldset w-fieldset--wide" data-case="on" data-of="tls">
      <legend class="w-fieldset__legend">{{ t "proto.tls_title" }}</legend>
      {{ template "proto/block" .TLS }}
    </fieldset>{{ end }}
  </fieldset>
</div>
{{ end }}{{ end }}
<div class="w-card" data-case="on" data-of="tls">
  <fieldset class="w-fieldset w-fieldset--wide">
    <legend class="w-card__title">{{ t "proto.tls_title" }}</legend>
    {{ template "proto/tls-block" .TLSBlock }}
  </fieldset>
</div>
{{- end }}

{{/* proto/block: the options of a block by kind: the fields in a grid, then the checkboxes, then the lists;
     protoform.BlockView. */ -}}
{{ define "proto/block" -}}
{{ if .Fields }}<div class="w-grid w-grid--2">
  {{ range .Fields }}{{ template "proto/option" . }}
  {{ end }}
</div>{{ end }}
{{ range .Checks }}<label class="w-check"><input type="checkbox" name="{{ .Name }}" value="1"{{ if .Checked }} checked{{ end }}> <span>{{ .Label }} (<code class="w-code">{{ .Code }}</code>)</span></label>
{{ end }}
{{ range .Lists }}{{ template "proto/dual" . }}
{{ end }}
{{- end }}

{{/* proto/option: a text, number or select field, protoform.OptionView. */ -}}
{{ define "proto/option" -}}
{{ if eq .Kind "select" -}}
<div class="w-field{{ if .Short }} w-field--short{{ end }}">
  <label class="w-field__label" for="{{ .Name }}">{{ .Label }} <span class="w-field__opt"><code class="w-code">{{ .Code }}</code></span></label>
  <select class="w-select" id="{{ .Name }}" name="{{ .Name }}"{{ if .Hint }} aria-describedby="{{ .Name }}-h"{{ end }}>{{ range .Choices }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}</select>
  {{ if .Hint }}<span class="w-field__hint" id="{{ .Name }}-h">{{ .Hint }}</span>{{ end }}
</div>
{{- else -}}
{{ template "proto/field" (dict "ID" .Name "Label" .Label "F" (dict "Value" .Value "Error" .Error) "Hint" .Hint "Short" .Short "Code" .Code "Num" (eq .Kind "number") "Min" .Min "Max" .Max) }}
{{- end }}
{{- end }}

{{/* proto/dual: a dual list (gui/dual) with its label and hint, protoform.OptionView. */ -}}
{{ define "proto/dual" -}}
<div class="w-field">
  <label class="w-field__label" for="{{ .Name }}">{{ .Label }} <span class="w-field__opt"><code class="w-code">{{ .Code }}</code></span></label>
  {{ template "gui/dual" (dict "ID" .Name "Name" .Name "Choices" .Choices "Describe" (printf "%s-h" .Name)) }}
  <span class="w-field__hint" id="{{ .Name }}-h">{{ .Hint }}</span>
</div>
{{- end }}

{{/* proto/tls-block: the TLS options of a TLS variant, protoform.BlockView: the minimum version, then the cipher
     suites, which only apply up to TLS 1.2 (crypto/tls does not let one configure the TLS 1.3 suites), so the list
     follows the version: a switch of its own, scoped by data-of. */ -}}
{{ define "proto/tls-block" -}}
<div class="w-grid w-grid--2">
  {{ range .Fields }}<div class="w-field w-field--short">
    <label class="w-field__label" for="{{ .Name }}">{{ .Label }} <span class="w-field__opt"><code class="w-code">{{ .Code }}</code></span></label>
    <select class="w-select" id="{{ .Name }}" name="{{ .Name }}" data-switch="tlsver" aria-describedby="{{ .Name }}-h">{{ range .Choices }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}</select>
    <span class="w-field__hint" id="{{ .Name }}-h">{{ .Hint }}</span>
  </div>
  {{ end }}
</div>
<fieldset class="w-fieldset w-fieldset--wide" data-case="v1.0 v1.1 v1.2" data-of="tlsver">
  {{ range .Lists }}{{ template "proto/dual" . }}{{ end }}
</fieldset>
{{- end }}
