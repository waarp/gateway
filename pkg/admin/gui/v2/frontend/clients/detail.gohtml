{{/* Details of a local client, in reading: the client (state, protocol, local address, automatic start), the
     automatic retries of its transfers, the options of its protocol, and the remote partners it can reach (the
     partners of its protocol: the two screens stay apart and are linked here, decision of 2026-10-19). Breadcrumb
     and a "Back to the list" button (decision D10); the other actions in a "⋯" menu. */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/clients/clients.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ t "clients.detail.title" "name" $d.Name }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.BackURL }}">{{ icon "arrow-left" }} {{ t "clients.back" }}</a>
    {{ with $d.EditURL }}<a class="w-btn w-btn--outline-dark" href="{{ . }}">{{ icon "pen" }} {{ t "clients.action.edit" }}</a>{{ end }}
    {{ template "gui/actions" (dict "ID" "act-detail" "Name" $d.Name "Items" $d.Actions) }}
  </div>
</div>
<div class="w-stack">
  <div class="w-card">
    <h2 class="w-card__title">{{ t "clients.detail.card" }}</h2>
    <dl class="w-deflist">
      <dt>{{ t "clients.detail.state" }}</dt><dd>{{ template "gui/status" $d.Status }}{{ with $d.Reason }} <code class="w-code">{{ . }}</code>{{ end }}</dd>
      {{ range $d.Identity }}<dt>{{ .Label }}</dt><dd>{{ if .Mono }}<code class="w-code">{{ .Value }}</code>{{ else }}{{ .Value }}{{ end }}</dd>
      {{ end }}
    </dl>
  </div>
  <div class="w-card">
    <h2 class="w-card__title">{{ t "clients.detail.retries" }}</h2>
    {{ if $d.NoRetries -}}
    <p class="clients-lead w-muted">{{ t "clients.detail.retries_none" }}</p>
    {{- else -}}
    <dl class="w-deflist">
      {{ range $d.Retries }}<dt>{{ .Label }}</dt><dd>{{ .Value }}</dd>
      {{ end }}
    </dl>
    {{- end }}
  </div>
  <div class="w-card">
    <h2 class="w-card__title">{{ t "proto.options" "protocol" $d.Protocol }}</h2>
    <dl class="w-deflist">
      {{ range $d.Options }}<dt>{{ .Label }}</dt><dd>{{ if .Mono }}<code class="w-code">{{ .Value }}</code>{{ else }}{{ .Value }}{{ end }}</dd>
      {{ end }}
    </dl>
  </div>
  <div class="w-card">
    <h2 class="w-card__title">{{ t "clients.detail.partners" }}</h2>
    <p class="clients-lead">{{ t "clients.detail.partners_hint" }}</p>
    {{ if $d.Partners -}}
    <div class="w-table-wrap">
      <table class="w-table">
        <caption class="visually-hidden">{{ t "clients.detail.partners" }}</caption>
        <thead><tr><th scope="col">{{ t "clients.detail.col_partner" }}</th><th scope="col">{{ t "clients.detail.col_address" }}</th></tr></thead>
        <tbody>
          {{ range $d.Partners }}<tr><td><a class="w-cell-title w-nowrap" href="{{ .URL }}">{{ .Name }}</a></td><td class="w-mono w-nowrap">{{ .Address }}</td></tr>
          {{ end }}
        </tbody>
      </table>
    </div>
    {{- else -}}
    <p class="clients-note w-muted">{{ t "clients.detail.partners_none" }}</p>
    {{- end }}
  </div>
</div>
{{- end }}
