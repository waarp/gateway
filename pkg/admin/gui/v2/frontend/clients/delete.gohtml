{{/* Confirmation page of the deletion of a local client (decision D10: a page, not a dialog). The title names the
     client, the text says the consequences, "Cancel" then "Delete" bottom right (D12). Refused (folder watchers
     use the client): the cause and the way out, no "Delete" button. */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/clients/clients.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ t "clients.delete.title" "name" $d.Name }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ icon "arrow-left" }} {{ t "clients.back_client" }}</a>
  </div>
</div>
<div class="w-card">
  {{ if $d.Blocked -}}
  {{ template "gui/banner" (dict "Kind" "ko" "Title" (t "clients.delete.blocked_title") "Text" (t "clients.delete.blocked_text")) }}
  {{- else -}}
  <p class="clients-lead">{{ t "clients.delete.text" }}{{ if $d.Running }} {{ t "clients.delete.running" }}{{ end }}</p>
  {{- end }}
  <dl class="w-deflist{{ if $d.Blocked }} clients-deflist{{ end }}">
    <dt>{{ t "clients.detail.card" }}</dt><dd>{{ $d.Name }}</dd>
    <dt>{{ t "clients.detail.state" }}</dt><dd>{{ template "gui/status" $d.Status }}</dd>
    <dt>{{ t "clients.detail.protocol" }}</dt><dd>{{ $d.Protocol }}</dd>
    <dt>{{ t "clients.detail.address" }}</dt><dd>{{ if $d.Address }}<code class="w-code">{{ $d.Address }}</code>{{ else }}{{ t "clients.address_auto" }}{{ end }}</dd>
  </dl>
  {{ if $d.Blocked -}}
  <div class="w-form__actions clients-form-actions"><a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ t "clients.back_client" }}</a></div>
  {{- else -}}
  <form class="clients-form-actions" method="post" action="{{ $d.Action }}">{{ template "gui/form-actions" (dict "CancelURL" $d.CancelURL "Danger" true "Title" (t "clients.delete.title" "name" $d.Name)) }}</form>
  {{- end }}
</div>
{{- end }}
