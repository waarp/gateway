{{/* Creation and edition of a local client, one page (decision D10), one card per block: identity (name, protocol
     as a family with TLS as an attribute, automatic start), local address (optional), automatic retries of the
     transfers (attempts, delay in hours / minutes / seconds, growth factor), then the options of the chosen
     protocol and the TLS block, rendered by the shared protocol partials. Refused form: a banner, the values kept,
     a message under each faulty field (422). Data: formData (Fields and Checks by field name, Proto). */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/proto/proto.css" }}"><link rel="stylesheet" href="{{ url "/static_v2/clients/clients.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data }}{{ $f := $d.Fields }}{{ $k := $d.Checks -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ $d.Title }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ icon "arrow-left" }} {{ if $d.Edit }}{{ t "clients.back_client" }}{{ else }}{{ t "clients.back" }}{{ end }}</a>
  </div>
</div>
{{ if $d.HasErrors }}<div class="clients-banner">{{ template "gui/banner" (dict "Kind" "ko" "Title" (t "clients.form.refused") "Text" (or $d.Refused (t "clients.form.refused_text"))) }}</div>{{ end }}
<form class="w-form" method="post" action="{{ $d.Action }}" novalidate>
  <div class="w-card">
    <fieldset class="w-fieldset w-fieldset--wide">
      <legend class="w-card__title">{{ t "clients.form.identity" }}</legend>
      <div class="w-grid w-grid--2">
        {{ template "proto/field" (dict "ID" "name" "Label" (t "clients.form.name") "Req" true "F" (index $f "name") "Hint" (t "clients.form.name_hint")) }}
        {{ template "proto/choice" $d.Proto.Choice }}
      </div>
      <label class="w-check"><input type="checkbox" name="no_autostart" value="1"{{ if index $k "no_autostart" }} checked{{ end }}> <span>{{ t "clients.form.no_autostart" }}</span></label>
    </fieldset>
  </div>

  <details class="w-card w-card--fold"{{ if $d.AddressOpen }} open{{ end }}>
    <summary>{{ icon "chevron-right" }}<span class="w-card__title">{{ t "clients.form.address" }}</span><span class="w-fold__meta">{{ $d.AddressSummary }}</span></summary>
    <div class="w-card__body">
      <fieldset class="w-fieldset w-fieldset--wide">
        <legend class="visually-hidden">{{ t "clients.form.address" }}</legend>
        <p class="w-form__note clients-note">{{ t "clients.form.address_hint" }}</p>
        <div class="w-grid w-grid--2">
          {{ template "proto/field" (dict "ID" "host" "Label" (t "clients.form.host") "F" (index $f "host") "Hint" (t "clients.form.host_hint")) }}
          {{ template "proto/field" (dict "ID" "port" "Label" (t "clients.form.port") "F" (index $f "port") "Hint" (t "clients.form.port_hint") "Short" true "Num" true "Min" 1 "Max" 65535) }}
        </div>
      </fieldset>
    </div>
  </details>

  <details class="w-card w-card--fold"{{ if $d.RetriesOpen }} open{{ end }}>
    <summary>{{ icon "chevron-right" }}<span class="w-card__title">{{ t "clients.form.retries" }}</span><span class="w-fold__meta">{{ $d.RetriesSummary }}</span></summary>
    <div class="w-card__body">
      <fieldset class="w-fieldset w-fieldset--wide">
        <legend class="visually-hidden">{{ t "clients.form.retries" }}</legend>
        <p class="w-form__note clients-note">{{ t "clients.form.retries_hint" }}</p>
        <div class="w-grid w-grid--2">
          {{ template "proto/field" (dict "ID" "attempts" "Label" (t "clients.retries.attempts") "F" (index $f "attempts") "Hint" (t "clients.retries.attempts_hint") "Short" true "Num" true "Min" 0 "Max" 127 "Code" "nbOfAttempts") }}
          {{ template "proto/field" (dict "ID" "factor" "Label" (t "clients.retries.factor") "F" (index $f "factor") "Hint" (t "clients.retries.factor_hint") "Short" true "Code" "retryIncrementFactor") }}
        </div>
        <fieldset class="w-fieldset clients-delay" aria-describedby="delay-h">
          <legend class="w-field__label">{{ t "clients.retries.delay" }} <span class="w-field__opt"><code class="w-code">firstRetryDelay</code></span></legend>
          <div class="clients-delay__parts">
            {{ template "clients/delay" (dict "ID" "delay_h" "Label" (t "clients.retries.hours") "F" (index $f "delay_h")) }}
            {{ template "clients/delay" (dict "ID" "delay_m" "Label" (t "clients.retries.minutes") "F" (index $f "delay_m") "Max" 59) }}
            {{ template "clients/delay" (dict "ID" "delay_s" "Label" (t "clients.retries.seconds") "F" (index $f "delay_s") "Max" 59) }}
          </div>
          <span class="w-field__hint" id="delay-h">{{ t "clients.retries.delay_hint" }}</span>
        </fieldset>
      </fieldset>
    </div>
  </details>

  {{ template "proto/options" $d.Proto }}

  {{ template "gui/form-actions" (dict "CancelURL" $d.CancelURL "Required" true "Title" $d.Title) }}
</form>
{{- end }}

{{/* clients/delay: one part of the delay (hours, minutes or seconds), a short number with its unit as label.
     ID, Label, F, Max. */ -}}
{{ define "clients/delay" -}}
<div class="w-field w-field--short{{ if .F.Error }} is-invalid{{ end }}">
  <label class="w-field__label" for="{{ .ID }}">{{ .Label }}</label>
  <input class="w-input" id="{{ .ID }}" name="{{ .ID }}" value="{{ .F.Value }}" type="number" inputmode="numeric" step="1" min="0"{{ with .Max }} max="{{ . }}"{{ end }}{{ if .F.Error }} aria-invalid="true" aria-describedby="{{ .ID }}-e"{{ end }}>
  {{ if .F.Error }}<span class="w-field__error" id="{{ .ID }}-e">{{ icon "triangle" }} {{ .F.Error }}</span>{{ end }}
</div>
{{- end }}
