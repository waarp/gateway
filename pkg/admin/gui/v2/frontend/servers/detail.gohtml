{{/* Details of a local server, in reading: the "Details" tab of the server sheet, next to "Authentication" and
     "Local accounts" (links, one page per tab). Breadcrumb and a "Back to the list" button (decision D10); the
     other actions in a "⋯" menu; key/value lists, nothing else. */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/servers/servers.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ t "servers.detail.title" "name" $d.Name }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.BackURL }}">{{ icon "arrow-left" }} {{ t "servers.back" }}</a>
    {{ with $d.EditURL }}<a class="w-btn w-btn--outline-dark" href="{{ . }}">{{ icon "pen" }} {{ t "servers.action.edit" }}</a>{{ end }}
    {{ template "gui/actions" (dict "ID" "act-detail" "Name" $d.Name "Items" $d.Actions) }}
  </div>
</div>
{{ template "servers/tabs" $d.Tabs }}
<div class="w-stack">
  <div class="w-card">
    <h2 class="w-card__title">{{ t "servers.detail.card" }}</h2>
    <dl class="w-deflist">
      <dt>{{ t "servers.detail.state" }}</dt><dd>{{ template "gui/status" $d.Status }}{{ with $d.Reason }} <code class="w-code">{{ . }}</code>{{ end }}</dd>
      {{ range $d.Identity }}<dt>{{ .Label }}</dt><dd>{{ if .Mono }}<code class="w-code">{{ .Value }}</code>{{ else }}{{ .Value }}{{ end }}</dd>
      {{ end }}
    </dl>
  </div>
  <div class="w-card">
    <h2 class="w-card__title">{{ t "servers.detail.dirs" }}</h2>
    <dl class="w-deflist">
      {{ range $d.Dirs }}<dt>{{ .Label }}</dt><dd>{{ if .Value }}<code class="w-code">{{ .Value }}</code>{{ else }}<span class="w-muted">{{ t "servers.detail.undefined" }}</span>{{ end }}</dd>
      {{ end }}
    </dl>
  </div>
  <div class="w-card">
    <h2 class="w-card__title">{{ t "proto.options" "protocol" $d.Protocol }}</h2>
    <dl class="w-deflist">
      {{ range $d.Options }}<dt>{{ .Label }}</dt><dd>{{ if .Mono }}<code class="w-code">{{ .Value }}</code>{{ else }}{{ .Value }}{{ end }}</dd>
      {{ end }}
    </dl>
  </div>
</div>
{{- end }}
