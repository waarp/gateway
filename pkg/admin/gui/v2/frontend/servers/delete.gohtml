{{/* Confirmation page of the deletion of a local server (decision D10: a page, not a dialog). The title names the
     server, the text says the consequences, "Cancel" then "Delete" bottom right (D12). Refused (running transfers
     use one of its accounts): the cause and the way out, no "Delete" button. */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/servers/servers.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ t "servers.delete.title" "name" $d.Name }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ icon "arrow-left" }} {{ t "servers.back_server" }}</a>
  </div>
</div>
<div class="w-card">
  {{ if $d.Blocked -}}
  {{ template "gui/banner" (dict "Kind" "ko" "Title" (t "servers.delete.blocked_title") "Text" (t "servers.delete.blocked_text") "Action" (dict "Label" (t "servers.delete.blocked_link") "URL" $d.TransfersURL "Icon" "clock")) }}
  {{- else -}}
  <p class="servers-lead">{{ t "servers.delete.text" }}{{ if $d.Running }} {{ t "servers.delete.running" }}{{ end }}</p>
  {{- end }}
  <dl class="w-deflist{{ if $d.Blocked }} servers-deflist{{ end }}">
    <dt>{{ t "servers.detail.card" }}</dt><dd>{{ $d.Name }}</dd>
    <dt>{{ t "servers.detail.state" }}</dt><dd>{{ template "gui/status" $d.Status }}</dd>
    <dt>{{ t "servers.detail.protocol" }}</dt><dd>{{ $d.Protocol }}</dd>
    <dt>{{ t "servers.detail.address" }}</dt><dd><code class="w-code">{{ $d.Address }}</code></dd>
    <dt>{{ t "servers.detail.accounts" }}</dt><dd>{{ $d.Accounts }}</dd>
  </dl>
  {{ if $d.Blocked -}}
  <div class="w-form__actions servers-form-actions"><a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ t "servers.back_server" }}</a></div>
  {{- else -}}
  <form class="servers-form-actions" method="post" action="{{ $d.Action }}">{{ template "gui/form-actions" (dict "CancelURL" $d.CancelURL "Danger" true "Title" (t "servers.delete.title" "name" $d.Name)) }}</form>
  {{- end }}
</div>
{{- end }}
