{{/* Creation and edition of a local account. Creation (Driss, 2026-10-18): the account (login, allowed IP
     addresses) and its first authentication means on the same page, so that the link between them is plain; the
     next means are added in the sheet of the account. Edition: the login and the addresses only. Refused form: a
     banner, the values kept, a message under each faulty field (422). Data: accountFormData. */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/servers/servers.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ $d.Title }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ icon "arrow-left" }} {{ if $d.Edit }}{{ t "action.back" }}{{ else }}{{ t "servers.back_server" }}{{ end }}</a>
  </div>
</div>
{{ template "servers/tabs" $d.Tabs }}
{{ if $d.HasErrors }}<div class="servers-banner">{{ template "gui/banner" (dict "Kind" "ko" "Title" (t "accounts.form.refused") "Text" (or $d.Refused (t "accounts.form.refused_text"))) }}</div>{{ end }}
<form class="w-form" method="post" action="{{ $d.Action }}" enctype="multipart/form-data" novalidate>
  <div class="w-card">
    <fieldset class="w-fieldset w-fieldset--wide">
      <legend class="w-card__title">{{ t "accounts.form.card" "name" $d.Server }}</legend>
      <div class="w-grid w-grid--2">
        {{ template "servers/field" (dict "ID" "login" "Label" (t "accounts.form.login") "Req" true "F" $d.Login "Hint" (t "accounts.form.login_hint")) }}
        <div class="w-field{{ if $d.IPs.Error }} is-invalid{{ end }}">
          <label class="w-field__label" for="ips">{{ t "accounts.form.ips" }} <span class="w-field__opt">{{ t "form.optional" }}</span></label>
          <textarea class="w-textarea w-mono" id="ips" name="ips" rows="3" spellcheck="false" placeholder="10.20.30.4" aria-describedby="ips-h"{{ if $d.IPs.Error }} aria-invalid="true"{{ end }}>{{ $d.IPs.Value }}</textarea>
          {{ if $d.IPs.Error }}<span class="w-field__error" id="ips-h">{{ icon "triangle" }} {{ $d.IPs.Error }}</span>{{ else }}<span class="w-field__hint" id="ips-h">{{ t "accounts.form.ips_hint" }}</span>{{ end }}
        </div>
      </div>
    </fieldset>
  </div>
  {{ with $d.Means -}}
  <div class="w-card">
    <fieldset class="w-fieldset w-fieldset--wide">
      <legend class="w-card__title">{{ t "accounts.form.first_means" }} <span class="w-field__opt">{{ t "form.optional" }}</span></legend>
      <p class="w-form__note servers-note">{{ t "accounts.form.first_means_hint" }}</p>
      <div class="w-grid w-grid--2">
        {{ template "servers/field" (dict "ID" "means_name" "Label" (t "accounts.form.means_name") "F" .Name "Hint" (t "accounts.form.means_name_hint")) }}
        <div class="w-field{{ if .TypeError }} is-invalid{{ end }}">
          <label class="w-field__label" for="means_type">{{ t "accounts.form.means_type" }} <span class="w-field__opt">{{ t "form.optional" }}</span></label>
          <select class="w-select" id="means_type" name="means_type" data-switch="means_type" aria-describedby="means_type-h"{{ if .TypeError }} aria-invalid="true"{{ end }}>{{ range .Types }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}</select>
          {{ if .TypeError }}<span class="w-field__error" id="means_type-h">{{ icon "triangle" }} {{ .TypeError }}</span>{{ else }}<span class="w-field__hint" id="means_type-h">{{ t "accounts.form.means_type_hint" }}</span>{{ end }}
        </div>
      </div>
      {{ template "servers/cred-fields" . }}
    </fieldset>
  </div>
  {{- end }}
  {{ template "gui/form-actions" (dict "CancelURL" $d.CancelURL "Required" true "Title" $d.Title) }}
</form>
{{- end }}
