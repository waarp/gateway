{{/* Creation and edition of a local server, one page (decision D10), one card per block: identity (name, protocol
     as a family with TLS as an attribute, automatic start), listening address, directories, then the options of the
     chosen protocol and the TLS block, rendered by the shared protocol partials (proto/choice, proto/options):
     the cards of every family are rendered, the family select shows the one of its value and the TLS checkbox the
     TLS card; without JavaScript every block is visible and the server reads the right one. Refused form: a
     banner, the values kept, a message under each faulty field (422). Data: formData (Fields and Checks by field
     name, Proto: the prepared protoform.Form). */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/proto/proto.css" }}"><link rel="stylesheet" href="{{ url "/static_v2/servers/servers.css" }}">{{ end }}

{{ define "page" -}}
{{ $d := .Data }}{{ $f := $d.Fields }}{{ $k := $d.Checks -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ $d.Title }}</h1>
  </div>
  <div class="w-page-header__actions">
    <a class="w-btn w-btn--outline-dark" href="{{ $d.CancelURL }}">{{ icon "arrow-left" }} {{ if $d.Edit }}{{ t "servers.back_server" }}{{ else }}{{ t "servers.back" }}{{ end }}</a>
  </div>
</div>
{{ if $d.HasErrors }}<div class="servers-banner">{{ template "gui/banner" (dict "Kind" "ko" "Title" (t "servers.form.refused") "Text" (or $d.Refused (t "servers.form.refused_text"))) }}</div>{{ end }}
<form class="w-form" method="post" action="{{ $d.Action }}" novalidate>
  <div class="w-card">
    <fieldset class="w-fieldset w-fieldset--wide">
      <legend class="w-card__title">{{ t "servers.form.identity" }}</legend>
      <div class="w-grid w-grid--2">
        {{ template "proto/field" (dict "ID" "name" "Label" (t "servers.form.name") "Req" true "F" (index $f "name") "Hint" (t "servers.form.name_hint")) }}
        {{ template "proto/choice" $d.Proto.Choice }}
      </div>
      <label class="w-check"><input type="checkbox" name="no_autostart" value="1"{{ if index $k "no_autostart" }} checked{{ end }}> <span>{{ t "servers.form.no_autostart" }}</span></label>
    </fieldset>
  </div>

  <div class="w-card">
    <fieldset class="w-fieldset w-fieldset--wide">
      <legend class="w-card__title">{{ t "servers.form.address" }}</legend>
      <div class="w-grid w-grid--2">
        {{ template "proto/field" (dict "ID" "host" "Label" (t "servers.form.host") "F" (index $f "host") "Hint" (t "servers.form.host_hint")) }}
        {{ template "proto/field" (dict "ID" "port" "Label" (t "servers.form.port") "Req" true "F" (index $f "port") "Hint" (t "servers.form.port_hint") "Short" true "Num" true "Min" 1 "Max" 65535) }}
      </div>
    </fieldset>
  </div>

  <div class="w-card">
    <fieldset class="w-fieldset w-fieldset--wide">
      <legend class="w-card__title">{{ t "servers.form.dirs" }}</legend>
      <p class="w-form__note servers-note">{{ t "servers.form.dirs_hint" }}</p>
      <div class="w-grid w-grid--2">
        {{ template "proto/field" (dict "ID" "root_dir" "Label" (t "servers.dirs.root") "F" (index $f "root_dir")) }}
        {{ template "proto/field" (dict "ID" "receive_dir" "Label" (t "servers.dirs.receive") "F" (index $f "receive_dir")) }}
        {{ template "proto/field" (dict "ID" "tmp_receive_dir" "Label" (t "servers.dirs.tmp") "F" (index $f "tmp_receive_dir") "Hint" (t "servers.form.tmp_hint")) }}
        {{ template "proto/field" (dict "ID" "send_dir" "Label" (t "servers.dirs.send") "F" (index $f "send_dir")) }}
      </div>
    </fieldset>
  </div>

  {{ template "proto/options" $d.Proto }}

  {{ template "gui/form-actions" (dict "CancelURL" $d.CancelURL "Required" true "Title" $d.Title) }}
</form>
{{- end }}
