{{/* Home page (screen sheet validated by Driss on 2026-10-19, revised the same day): one card per section of the
     sidebar, side by side, each listing as link cards the screens the user may read (the handler filters by the
     real right of each page): the icon and the name side by side, the sentence of the glossary under the name (on
     trial). The page fits the height of the sidebar: no breadcrumb (the title says it), no data, no action, no
     sidebar entry. Data: pageData. */ -}}
{{ define "page" -}}
{{ $d := .Data -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <h1 class="w-page-header__title">{{ t "home.title" }}</h1>
  </div>
</div>
<div class="w-grid w-grid--4">
  {{ range $d.Sections -}}
  <section class="w-card" aria-labelledby="home-{{ .Key }}">
    <h2 class="w-card__title" id="home-{{ .Key }}">{{ .Title }}</h2>
    <div class="w-stack w-stack--tight">
      {{ range .Cards }}{{ template "gui/link-card" . }}
      {{ end }}
    </div>
  </section>
  {{ end -}}
</div>
{{- end }}
