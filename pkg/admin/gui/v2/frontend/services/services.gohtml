{{/* Service status screen (Supervision). Presentation only: the handler sorts the rows, counts the states, pages
     the tables and translates the texts. The three tiles are tabs that show one table at a time (kit.js); without
     JavaScript they are links the server answers with ?group=. The "services/state" block is also served alone
     (?fragment=state) and refreshed in place by services.js; without JavaScript, "Refresh" reloads the page. */ -}}
{{ define "head" }}<link rel="stylesheet" href="{{ url "/static_v2/services/services.css" }}">{{ end }}
{{ define "scripts" }}<script src="{{ url "/static_v2/services/services.js" }}" defer></script>{{ end }}

{{ define "page" -}}
<div class="w-page-header">
  <div class="w-page-header__text">
    <p class="w-page-header__eyebrow">{{ t "nav.supervision" }}</p>
    <h1 class="w-page-header__title">{{ t "services.title" }}</h1>
  </div>
  <div class="w-page-header__actions">
    <span class="w-live" id="services-live" role="status" aria-live="polite" data-live="{{ t "services.live" "seconds" .Data.RefreshSeconds }}" data-refreshing="{{ t "services.refreshing" }}">{{ t "services.live" "seconds" .Data.RefreshSeconds "time" .Data.RefreshedAt }}</span>
    <a class="w-btn w-btn--outline-dark" id="services-refresh" href="{{ url "/services" }}">{{ t "action.refresh" }}</a>
  </div>
</div>
{{ template "services/state" .Data }}
<template id="services-error">{{ template "gui/banner" (dict "Kind" "ko" "Title" (t "services.error.title") "Text" (t "services.error.text" "seconds" .Data.RefreshSeconds) "Action" (dict "Label" (t "action.retry") "URL" (url "/services"))) }}</template>
{{- end }}

{{ define "services/state" -}}
<div id="etat" data-fragment-url="{{ url "/services" }}" data-refresh-seconds="{{ .RefreshSeconds }}" data-refreshed-at="{{ .RefreshedAt }}">
  <div class="w-grid w-grid--3" role="tablist" aria-label="{{ t "services.groups" }}">
    {{ range .Groups }}{{ template "gui/tile" .Tile }}{{ end }}
  </div>
  {{ range .Groups }}
  <section class="services-panel" role="tabpanel" id="{{ .ID }}" aria-labelledby="tab-{{ .ID }}"{{ if not .Selected }} hidden{{ end }}>
    {{ if .Rows -}}
    <div class="w-table-wrap">
      <table class="w-table">
        <caption class="visually-hidden">{{ .Caption }}</caption>
        <colgroup><col class="services-col-name"><col class="services-col-state"><col></colgroup>
        <thead><tr><th scope="col">{{ .Kind }}</th><th scope="col">{{ t "services.col.state" }}</th><th scope="col">{{ t "services.col.reason" }}</th></tr></thead>
        <tbody>
          {{ range .Rows }}<tr>
            <td>{{ if .Tech }}<div class="w-cell-stack"><span class="w-cell-title">{{ .Name }}</span><span class="w-cell-sub"><code class="w-code">{{ .Tech }}</code></span></div>{{ else }}<span class="w-cell-title w-nowrap">{{ .Name }}</span>{{ end }}</td>
            <td>{{ template "gui/status" .Status }}</td>
            {{ if .Reason }}<td class="w-mono">{{ .Reason }}</td>{{ else }}<td><span class="w-muted" aria-hidden="true">—</span><span class="visually-hidden">{{ t "services.reason.none" }}</span></td>{{ end }}
          </tr>
          {{ end }}
        </tbody>
      </table>
    </div>
    {{ with .Pager }}<div class="services-pager">{{ template "gui/pager" . }}</div>{{ end }}
    {{- else -}}
    {{ template "gui/empty" .Empty }}
    {{- end }}
  </section>
  {{ end }}
</div>
{{- end }}
