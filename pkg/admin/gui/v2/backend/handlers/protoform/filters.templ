package protoform

import "code.waarp.fr/lib/gui"

// FiltersPanel: the protocol filters of a list (local servers, local clients,
// remote partners), on one line where the width allows (2026-10-23): the
// families as joined buttons that each toggle on their own, several may be
// chosen, then the TLS filter as three joined buttons ("All", "With TLS",
// "Without TLS"). A chosen button shows its border, bold text and check (the
// w-segmented buttons of the kit). The form posts what the checkboxes and the
// select posted before: protocol (repeated) and tls.
templ FiltersPanel(legend string, families []FilterBox, tls []Choice) {
	<div class="proto-filters">
		<fieldset class="w-fieldset">
			<legend class="w-fieldset__legend">{ legend }</legend>
			<div class="w-segmented">
				for _, f := range families {
					<label>
						<input type="checkbox" name="protocol" value={ f.Key } checked?={ f.Checked }/>
						<span>
							@gui.Icon("check")
							{ f.Label }
						</span>
					</label>
				}
			</div>
		</fieldset>
		<fieldset class="w-fieldset">
			<legend class="w-fieldset__legend">{ gui.T(ctx, "proto.filter_tls") }</legend>
			<div class="w-segmented">
				for _, c := range tls {
					<label>
						<input type="radio" name="tls" value={ c.Value } checked?={ c.Selected }/>
						<span>
							@gui.Icon("check")
							{ c.Label }
						</span>
					</label>
				}
			</div>
		</fieldset>
	</div>
}
