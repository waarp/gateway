package means

import (
	"fmt"
	"strconv"

	"code.waarp.fr/lib/gui"

	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/liststate"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/protoform"
)

// TabsNav: the tab strip of a sheet. Links, not script tabs: each tab is a
// page with its own list and its own address. On the form of an object not
// created yet, the current tab has no address and the others are greyed.
templ TabsNav(label string, tabs []Tab) {
	<nav class="w-tabs" aria-label={ label }>
		for _, t := range tabs {
			if t.Disabled {
				<span class="w-tabs__disabled" aria-disabled="true" title={ t.Hint }>{ t.Label }</span>
			} else if t.URL == "" {
				<span aria-current="page">{ t.Label }</span>
			} else {
				<a
					href={ templ.SafeURL(t.URL) }
					if t.Current {
						aria-current="page"
					}
				>{ t.Label }@tabCount(t)</a>
			}
		}
	</nav>
}

templ tabCount(t Tab) {
	if t.HasCount {
		{ " " }<span class="w-tabs__count">{ strconv.FormatUint(t.Count, 10) }</span>
	}
}

// NotFoundView: an object of a sheet that does not exist: localised 404 in
// the chrome, with the way back (the list as the user left it, the tab of
// the owner).
templ NotFoundView(d NotFoundData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
	</div>
	@gui.Empty(gui.EmptyProps{Icon: d.Icon, Title: d.Text, Action: &gui.Link{Label: d.BackLabel, URL: d.BackURL, Icon: "arrow-left"}})
}

// content: the non-secret content of a means, with the validity of a
// certificate.
templ content(r row) {
	if r.Expiry.State != "" {
		<div class="w-cell-stack">@gui.StatusOf(r.Expiry)<span class="w-cell-sub">{ r.Summary }</span></div>
	} else {
		{ r.Summary }
	}
}

// table: the states of the tab (no means possible for the protocol, none
// yet, no match), the toolbar (search by name), the table (name, kind,
// non-secret content with the validity of a certificate, "⋯") and the list
// foot.
templ table(d listData) {
	if d.NonePossible {
		@gui.Empty(gui.EmptyProps{Icon: "key", Title: d.NoneTitle, Text: d.NoneText})
	} else if d.List.Empty {
		@gui.Empty(gui.EmptyProps{Icon: "key", Title: gui.T(ctx, "auth.empty.title"), Text: d.EmptyText, Action: liststate.AddLink(d.AddURL, gui.T(ctx, "auth.add"))})
	} else {
		<div data-live data-live-period="0">
			<form class="w-toolbar" role="search" method="get" action={ templ.SafeURL(d.List.Action) } data-autosubmit data-live-filter>
				for _, h := range liststate.SortedHidden(d.List.Hidden) {
					<input type="hidden" name={ h.Name } value={ h.Value }/>
				}
				<label class="w-search"><span class="visually-hidden">{ gui.T(ctx, "auth.search") }</span>@gui.Icon("search")<input type="search" name="q" value={ d.List.Q } placeholder={ gui.T(ctx, "auth.search_placeholder") } title={ gui.T(ctx, "lists.search_hint") } list="auth-names" autocomplete="off"/></label>
				<datalist id="auth-names">
					for _, n := range d.List.Names {
						<option value={ n }></option>
					}
				</datalist>
				<span class="w-toolbar__spacer"></span>
				<span class="w-toolbar__count" id="auth-count" data-live-part="list" aria-live="polite">{ d.List.Count }</span>
			</form>
			@authRegion(d)
			<template data-live-error>@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "lists.refresh_error.title"), Text: gui.T(ctx, "lists.refresh_error.text"), Action: &gui.Link{Label: gui.T(ctx, "action.retry"), URL: d.List.Action}})</template>
		</div>
	}
}

// authRegion: the region of the list, the part "list" of the live list of
// the kit (with the count of the toolbar): read and put in place as the
// filters, the sort or the page change (#766).
templ authRegion(d listData) {
	<div id="auth-list" data-live-part="list" data-live-paged>
		if d.List.NoMatch {
			@gui.Empty(gui.EmptyProps{Icon: "search", Title: d.List.NoMatchText, Action: &gui.Link{Label: d.List.NoMatchLink, URL: d.List.NoMatchURL}})
		} else {
			<div class="w-table-wrap">
				<table class="w-table">
					<caption class="visually-hidden">{ d.List.Caption }</caption>
					<colgroup><col class="sheet-col-cred"/><col class="sheet-col-type"/><col/><col class="sheet-col-actions"/></colgroup>
					<thead>
						<tr>
							@gui.Th(gui.ThProps{Label: gui.T(ctx, "auth.col.name"), Key: "name", Sort: d.List.Sort, Dir: d.List.Dir, Base: d.List.Base})
							@gui.Th(gui.ThProps{Label: gui.T(ctx, "auth.col.type"), Key: "type", Sort: d.List.Sort, Dir: d.List.Dir, Base: d.List.Base})
							<th scope="col">{ gui.T(ctx, "auth.col.content") }</th>
							<th scope="col"><span class="visually-hidden">{ gui.T(ctx, "actions.title") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range d.Rows {
							<tr>
								<td><a class="w-cell-title w-nowrap" href={ templ.SafeURL(r.URL) }>{ r.Name }</a></td>
								<td>{ r.Type }</td>
								<td>@content(r)</td>
								<td>@gui.Actions(gui.ActionsProps{ID: fmt.Sprintf("act-c%d", r.ID), Name: r.Name, Items: r.Actions})</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if d.List.Pager != nil {
				<div class="sheet-pager">@gui.Pager(d.List.Pager.Props(d.List.PagerHidden, d.List.Sizes, d.List.Size))</div>
			}
		}
	</div>
}

// authFragment: what ?fragment=list serves to the live list of the kit: the
// elements of the part "list", with the ids of the page, without the shell.
templ authFragment(d listData) {
	<span class="w-toolbar__count" id="auth-count" data-live-part="list" aria-live="polite">{ d.List.Count }</span>
	@authRegion(d)
}

// keyIf is the catalogue key of a hint that differs on edition.
func keyIf(edit bool, onEdit, onCreate string) string {
	if edit {
		return onEdit
	}

	return onCreate
}

// CredFields: the content of a means, one block per family. At creation
// every block is rendered and the kind select shows the right one
// (data-switch named "<Prefix>type"; without JavaScript every block is
// visible and the server reads the block of the chosen kind). On edition
// only the block of the kind is rendered, with what is in place next to each
// field: an empty field keeps it. Secrets are never pre-filled.
templ CredFields(f *Form) {
	if !f.Edit || f.Family == "password" {
		<fieldset
			class="w-fieldset w-fieldset--wide"
			if !f.Edit {
				data-case="password"
				data-of={ f.Prefix + "type" }
			}
		>
			<legend class="w-fieldset__legend">{ gui.T(ctx, "auth.form.password") }</legend>
			<div class="w-grid w-grid--2">
				<div class={ "w-field", templ.KV("is-invalid", f.Password.Error != "") }>
					<label class="w-field__label" for={ f.Prefix + "password" }>{ gui.T(ctx, "auth.form.password") }@protoform.ReqMark(!f.Edit)</label>
					<input
						class="w-input"
						type="password"
						id={ f.Prefix + "password" }
						name={ f.Prefix + "password" }
						autocomplete="new-password"
						aria-describedby={ f.Prefix + "password-h" }
						if f.Password.Error != "" {
							aria-invalid="true"
						}
					/>
					if f.Password.Error != "" {
						<span class="w-field__error" id={ f.Prefix + "password-h" }>
							@gui.Icon("triangle")
							{ f.Password.Error }
						</span>
					} else if f.Edit {
						<span class="w-field__hint" id={ f.Prefix + "password-h" }>{ f.CurrentPassword + " · " + gui.T(ctx, "auth.form.password_keep") }</span>
					} else {
						<span class="w-field__hint" id={ f.Prefix + "password-h" }>{ gui.T(ctx, "auth.form.password_hint") }</span>
					}
				</div>
			</div>
		</fieldset>
	}
	if !f.Edit || f.Family == "file" {
		<fieldset
			class="w-fieldset w-fieldset--wide"
			if !f.Edit {
				data-case="trusted_tls_certificate ssh_private_key ssh_public_key"
				data-of={ f.Prefix + "type" }
			}
		>
			<legend class="w-fieldset__legend">{ gui.T(ctx, "auth.form.file") }</legend>
			<div class={ "w-field", templ.KV("is-invalid", f.Pem.Error != "") }>
				<label class="w-field__label" for={ f.Prefix + "file" }>{ gui.T(ctx, "auth.form.file") }@protoform.ReqMark(!f.Edit)</label>
				@gui.File(gui.FileProps{ID: f.Prefix + "file", Name: f.Prefix + "file", Current: f.CurrentFile, Accept: ".pem,.crt,.cer,.key,.pub", Describe: f.Prefix + "file-h", Multiple: true, Needed: !f.Edit, Paste: f.Prefix + "pem"})
				@protoform.Message(f.Prefix+"file-h", f.Pem.Error, gui.T(ctx, keyIf(f.Edit, "auth.form.keep_file", "auth.form.file_hint")))
			</div>
			<div class="w-field">
				<label class="w-field__label" for={ f.Prefix + "pem" }>{ gui.T(ctx, "auth.form.paste") } <span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span></label>
				<textarea class="w-textarea w-mono" id={ f.Prefix + "pem" } name={ f.Prefix + "pem" } rows="4" spellcheck="false" placeholder="-----BEGIN …-----">{ f.Pem.Value }</textarea>
			</div>
		</fieldset>
	}
	if !f.Edit || f.Family == "twofile" {
		<fieldset
			class="w-fieldset w-fieldset--wide"
			if !f.Edit {
				data-case="tls_certificate"
				data-of={ f.Prefix + "type" }
			}
		>
			<legend class="w-fieldset__legend">{ gui.T(ctx, "auth.type.tls_certificate") }</legend>
			<div class="w-grid w-grid--2">
				<div class={ "w-field", templ.KV("is-invalid", f.PemCert.Error != "") }>
					<label class="w-field__label" for={ f.Prefix + "cert_file" }>{ gui.T(ctx, "auth.form.cert") }@protoform.ReqMark(!f.Edit)</label>
					@gui.File(gui.FileProps{ID: f.Prefix + "cert_file", Name: f.Prefix + "cert_file", Current: f.CurrentCert, Accept: ".pem,.crt,.cer", Describe: f.Prefix + "cert-h", Multiple: true, Needed: !f.Edit, Paste: f.Prefix + "cert_pem"})
					@protoform.Message(f.Prefix+"cert-h", f.PemCert.Error, gui.T(ctx, keyIf(f.Edit, "auth.form.keep_file", "auth.form.cert_hint")))
					<label class="w-field__label sheet-paste" for={ f.Prefix + "cert_pem" }>{ gui.T(ctx, "auth.form.paste_cert") } <span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span></label>
					<textarea class="w-textarea w-mono" id={ f.Prefix + "cert_pem" } name={ f.Prefix + "cert_pem" } rows="4" spellcheck="false" placeholder="-----BEGIN CERTIFICATE-----">{ f.PemCert.Value }</textarea>
				</div>
				<div class={ "w-field", templ.KV("is-invalid", f.PemKey.Error != "") }>
					<label class="w-field__label" for={ f.Prefix + "key_file" }>{ gui.T(ctx, "auth.form.key") }@protoform.ReqMark(!f.Edit)</label>
					@gui.File(gui.FileProps{ID: f.Prefix + "key_file", Name: f.Prefix + "key_file", Current: f.CurrentKey, Accept: ".pem,.key", Describe: f.Prefix + "key-h", Needed: !f.Edit, Paste: f.Prefix + "key_pem"})
					@protoform.Message(f.Prefix+"key-h", f.PemKey.Error, gui.T(ctx, keyIf(f.Edit, "auth.form.keep_file", "auth.form.key_hint")))
					<label class="w-field__label sheet-paste" for={ f.Prefix + "key_pem" }>{ gui.T(ctx, "auth.form.paste_key") } <span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span></label>
					<textarea class="w-textarea w-mono" id={ f.Prefix + "key_pem" } name={ f.Prefix + "key_pem" } rows="4" spellcheck="false" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
				</div>
			</div>
		</fieldset>
	}
	if !f.Edit || f.Family == "pair" {
		<fieldset
			class="w-fieldset w-fieldset--wide"
			if !f.Edit {
				data-case="pesit_pre-connection_auth"
				data-of={ f.Prefix + "type" }
			}
		>
			<legend class="w-fieldset__legend">{ gui.T(ctx, "auth.type.pesit_pre-connection_auth") }</legend>
			<p class="w-form__note sheet-note">{ gui.T(ctx, "auth.form.pre_hint") }</p>
			<div class="w-grid w-grid--2">
				<div class={ "w-field", templ.KV("is-invalid", f.PreLogin.Error != "") }>
					<label class="w-field__label" for={ f.Prefix + "pre_login" }>{ gui.T(ctx, "auth.form.pre_login") } <span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span></label>
					<input
						class="w-input w-mono"
						id={ f.Prefix + "pre_login" }
						name={ f.Prefix + "pre_login" }
						value={ f.PreLogin.Value }
						maxlength="8"
						spellcheck="false"
						autocomplete="off"
						aria-describedby={ f.Prefix + "pre_login-h" }
						if f.PreLogin.Error != "" {
							aria-invalid="true"
						}
					/>
					@protoform.Message(f.Prefix+"pre_login-h", f.PreLogin.Error, gui.T(ctx, "auth.form.pre_login_hint"))
				</div>
				<div class={ "w-field", templ.KV("is-invalid", f.PrePassword.Error != "") }>
					<label class="w-field__label" for={ f.Prefix + "pre_password" }>{ gui.T(ctx, "auth.form.pre_password") } <span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span></label>
					<input
						class="w-input"
						type="password"
						id={ f.Prefix + "pre_password" }
						name={ f.Prefix + "pre_password" }
						maxlength="8"
						autocomplete="new-password"
						aria-describedby={ f.Prefix + "pre_password-h" }
						if f.PrePassword.Error != "" {
							aria-invalid="true"
						}
					/>
					if f.PrePassword.Error != "" {
						<span class="w-field__error" id={ f.Prefix + "pre_password-h" }>
							@gui.Icon("triangle")
							{ f.PrePassword.Error }
						</span>
					} else if f.Edit {
						<span class="w-field__hint" id={ f.Prefix + "pre_password-h" }>{ f.CurrentPassword + " · " + gui.T(ctx, "auth.form.pre_password_keep") }</span>
					} else {
						<span class="w-field__hint" id={ f.Prefix + "pre_password-h" }>{ gui.T(ctx, "auth.form.pre_password_hint") }</span>
					}
				</div>
			</div>
		</fieldset>
	}
	if !f.Edit || f.Family == "none" {
		<fieldset
			class="w-fieldset w-fieldset--wide"
			if !f.Edit {
				data-case="r66_legacy_certificate"
				data-of={ f.Prefix + "type" }
			}
		>
			<legend class="w-fieldset__legend">{ gui.T(ctx, "auth.type.r66_legacy_certificate") }</legend>
			<p class="w-form__note sheet-note">{ gui.T(ctx, "auth.form.legacy_hint") }</p>
		</fieldset>
	}
}

// authView: "Authentication" tab of an owner. One coloured action, "Add an
// authentication means", when something can still be added; the tabs are
// links; the table never shows a secret.
templ authView(d listData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.BackURL) }>
				@gui.Icon("arrow-left")
				{ d.BackLabel }
			</a>
			if d.AddURL != "" {
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.AddURL) }>
					@gui.Icon("plus")
					{ gui.T(ctx, "auth.add") }
				</a>
			}
		</div>
	</div>
	@TabsNav(d.TabsLabel, d.Tabs)
	<p class="w-form__note sheet-intro">{ d.Intro }</p>
	@table(d)
}

// formView: creation and edition of an authentication means, under the tab
// strip of its owner. Two cards: the identity (name; kind among the ones the
// protocol allows and not already present when unique; the kind of an
// existing means does not change) and the content of the kind. Files arrive
// by a multipart form or pasted; a secret is never pre-filled and an empty
// field keeps it. Refused form: a banner, the non-secret values kept, a
// message under each faulty field.
templ formView(d *Form) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "action.back") }
			</a>
		</div>
	</div>
	@TabsNav(d.TabsLabel, d.Tabs)
	if d.HasErrors {
		<div class="sheet-banner">@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "auth.form.refused"), Text: protoform.Or(d.Refused, gui.T(ctx, "auth.form.refused_text"))})</div>
	}
	<form class="w-form" method="post" action={ templ.SafeURL(d.Action) } enctype="multipart/form-data" novalidate>
		<div class="w-card">
			<fieldset class="w-fieldset w-fieldset--wide">
				<legend class="w-card__title">{ gui.T(ctx, "auth.form.card", "owner", d.Owner) }</legend>
				<div class="w-grid w-grid--2">
					@protoform.FieldOf(protoform.FieldProps{ID: "name", Label: gui.T(ctx, "auth.form.name"), F: d.Name, Hint: gui.T(ctx, "auth.form.name_hint")})
					if d.Edit {
						<div class="w-field">
							<label class="w-field__label" for="type">{ gui.T(ctx, "auth.form.type") }</label>
							<input class="w-input" id="type" value={ d.TypeLabel } readonly aria-describedby="type-h"/>
							<span class="w-field__hint" id="type-h">{ gui.T(ctx, "auth.form.type_fixed") }</span>
						</div>
					} else {
						<div class={ "w-field", templ.KV("is-invalid", d.TypeError != "") }>
							<label class="w-field__label" for="type">{ gui.T(ctx, "auth.form.type") } <span class="w-field__req" aria-hidden="true">*</span></label>
							<select
								class="w-select"
								id="type"
								name="type"
								required
								data-switch="type"
								aria-describedby="type-h"
								if d.TypeError != "" {
									aria-invalid="true"
								}
							>
								for _, c := range d.Types {
									<option value={ c.Value } selected?={ c.Selected }>{ c.Label }</option>
								}
							</select>
							@protoform.Message("type-h", d.TypeError, gui.T(ctx, "auth.form.type_hint"))
						</div>
					}
				</div>
			</fieldset>
		</div>
		<details class="w-card w-card--fold" open>
			<summary>@gui.Icon("chevron-right")<span class="w-card__title">{ gui.T(ctx, "auth.form.content") }</span></summary>
			<div class="w-card__body">
				<fieldset class="w-fieldset w-fieldset--wide">
					<legend class="visually-hidden">{ gui.T(ctx, "auth.form.content") }</legend>
					@CredFields(d)
				</fieldset>
			</div>
		</details>
		@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Required: true, Title: d.Title, NeedsNote: gui.T(ctx, "auth.form.needs")})
	</form>
}

// detailView: an authentication means in reading, under the tab strip of
// its owner. A certificate shows its subject, its issuer, its validity, its
// fingerprint and its PEM (public part); a public key its kind, its
// fingerprint and its line; a password or a private key is "set, never
// shown". "Edit" as a button (write right), "Delete" in the "⋯" menu (delete
// right).
templ detailView(d detailData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.BackURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "action.back") }
			</a>
			if d.EditURL != "" {
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.EditURL) }>
					@gui.Icon("pen")
					{ gui.T(ctx, "auth.action.edit") }
				</a>
			}
			if d.DeleteURL != "" {
				@gui.Actions(gui.ActionsProps{ID: "act-cred", Name: d.Name, Items: []gui.Action{{Icon: "trash", Label: gui.T(ctx, "auth.action.delete"), URL: d.DeleteURL, Danger: true}}})
			}
		</div>
	</div>
	@TabsNav(d.TabsLabel, d.Tabs)
	<div class="w-stack">
		<div class="w-card">
			<h2 class="w-card__title">{ gui.T(ctx, "auth.detail.card", "type", d.Type, "owner", d.Owner) }</h2>
			<dl class="w-deflist">
				if d.Expiry.State != "" {
					<dt>{ gui.T(ctx, "auth.detail.state") }</dt>
					<dd>@gui.StatusOf(d.Expiry)</dd>
				}
				for _, k := range d.Rows {
					<dt>{ k.Label }</dt>
					<dd>@protoform.ValueOf(k)</dd>
				}
			</dl>
		</div>
		if len(d.Chain) > 1 {
			<details class="w-card w-card--fold" data-key="mean-chain">
				<summary>@gui.Icon("chevron-right")<span class="w-card__title">{ gui.T(ctx, "auth.detail.chain") }</span><span class="w-fold__meta">{ gui.T(ctx, "auth.content.chain", "n", len(d.Chain)) }</span></summary>
				<div class="w-card__body">
					<div class="w-table-wrap">
						<table class="w-table">
							<caption class="visually-hidden">{ gui.T(ctx, "auth.detail.chain") }</caption>
							<thead>
								<tr>
									<th scope="col">{ gui.T(ctx, "auth.detail.chain_col.role") }</th>
									<th scope="col">{ gui.T(ctx, "auth.detail.chain_col.subject") }</th>
									<th scope="col">{ gui.T(ctx, "auth.detail.chain_col.issuer") }</th>
									<th scope="col">{ gui.T(ctx, "auth.detail.chain_col.validity") }</th>
									<th scope="col">{ gui.T(ctx, "auth.detail.chain_col.state") }</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range d.Chain {
									<tr>
										<td>{ c.Role }</td>
										<td class="w-mono">{ c.Subject }</td>
										<td class="w-mono">{ c.Issuer }</td>
										<td class="w-nowrap">{ c.Validity }</td>
										<td>@gui.StatusOf(c.Expiry)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<p class="w-form__note sheet-note">{ gui.T(ctx, "auth.detail.chain_note") }</p>
				</div>
			</details>
		}
		if d.Public != "" {
			<details class="w-card w-card--fold" data-key="mean-public">
				<summary>@gui.Icon("chevron-right")<span class="w-card__title">{ d.PublicTitle }</span><span class="w-fold__meta">{ d.PublicMeta }</span></summary>
				<div class="w-card__body">
					<pre class="w-code sheet-pem">{ d.Public }</pre>
					<p class="w-form__note sheet-note">{ gui.T(ctx, "auth.detail.public_note") }</p>
				</div>
			</details>
		}
	</div>
}

// deleteView: confirmation of the deletion of an authentication means
// (delete right), under the tab strip of its owner: the consequence, what is
// deleted, "Cancel" then "Delete" bottom right.
templ deleteView(d deleteData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "action.back") }
			</a>
		</div>
	</div>
	@TabsNav(d.TabsLabel, d.Tabs)
	<div class="w-card">
		<p class="sheet-lead">{ d.Text }</p>
		<dl class="w-deflist">
			<dt>{ gui.T(ctx, "auth.delete.means") }</dt>
			<dd>{ d.Name }</dd>
			<dt>{ gui.T(ctx, "auth.delete.type") }</dt>
			<dd>{ d.Type }</dd>
			<dt>{ gui.T(ctx, "auth.delete.owner") }</dt>
			<dd>{ d.Owner }</dd>
			<dt>{ gui.T(ctx, "auth.delete.content") }</dt>
			<dd>{ d.Summary }</dd>
		</dl>
		<form class="sheet-form-actions" method="post" action={ templ.SafeURL(d.Action) }>@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Danger: true, Title: d.Title})</form>
	</div>
}
