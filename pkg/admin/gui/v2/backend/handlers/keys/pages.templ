package keys

import (
	"context"
	"fmt"

	"code.waarp.fr/lib/gui"

	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/liststate"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/protoform"
)

// listView: the cryptographic keys (Treatments). Presentation only: the
// handler searches, filters, sorts and pages the rows, builds the row
// actions from the rights and translates the texts. One coloured action
// ("Add a key"); the type filter applied as soon as it changes; two sortable
// headers; the state as a status (shape and words); how many rules use each
// key; a "⋯" menu per row; rows per page in the foot.
templ listView(d listData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ gui.T(ctx, "keys.title") }</h1>
		</div>
		if d.AddURL != "" {
			<div class="w-page-header__actions">
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.AddURL) }>
					@gui.Icon("plus")
					{ gui.T(ctx, "keys.add") }
				</a>
			</div>
		}
	</div>
	if d.Error {
		@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "keys.error.title"), Text: gui.T(ctx, "keys.error.text"), Action: &gui.Link{Label: gui.T(ctx, "action.retry"), URL: d.RetryURL}})
	} else if d.Empty {
		@gui.Empty(gui.EmptyProps{Icon: "key", Title: gui.T(ctx, "keys.empty.title"), Text: gui.T(ctx, "keys.empty.text"), Action: liststate.AddLink(d.AddURL, gui.T(ctx, "keys.add"))})
	} else {
		<form class="w-toolbar" role="search" method="get" action={ templ.SafeURL(d.Action) } data-autosubmit>
			for _, h := range liststate.SortedHidden(d.Hidden) {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
			<label class="w-search"><span class="visually-hidden">{ gui.T(ctx, "keys.search") }</span>@gui.Icon("search")<input type="search" name="q" value={ d.Q } placeholder={ gui.T(ctx, "keys.search_placeholder") } list="keys-names" autocomplete="off"/></label>
			<datalist id="keys-names">
				for _, n := range d.Names {
					<option value={ n }></option>
				}
			</datalist>
			<details class="w-disclose" open?={ d.FiltersOpen }>
				<summary class="w-btn w-btn--outline-dark w-btn--sm">
					@gui.Icon("filter")
					{ gui.T(ctx, "filters.title") + liststate.CountSuffix(d.FiltersCount) }
				</summary>
				<div class="w-disclose__panel">
					@filterBoxes(gui.T(ctx, "keys.filters_type"), d.Types)
					@gui.FiltersFoot(d.ResetURL)
				</div>
			</details>
			<span class="w-toolbar__spacer"></span>
			<span class="w-toolbar__count" aria-live="polite">{ d.Count }</span>
		</form>
		if d.NoMatch {
			@gui.Empty(gui.EmptyProps{Icon: "search", Title: d.NoMatchText, Action: &gui.Link{Label: d.NoMatchLink, URL: d.NoMatchURL}})
		} else {
			<div class="w-table-wrap">
				<table class="w-table">
					<caption class="visually-hidden">{ d.Caption }</caption>
					<colgroup><col class="keys-col-name"/><col class="keys-col-type"/><col class="keys-col-detail"/><col/><col class="keys-col-uses"/><col class="keys-col-actions"/></colgroup>
					<thead>
						<tr>
							@gui.Th(gui.ThProps{Label: gui.T(ctx, "keys.col.name"), Key: "name", Sort: d.Sort, Dir: d.Dir, Base: d.Base})
							@gui.Th(gui.ThProps{Label: gui.T(ctx, "keys.col.type"), Key: "type", Sort: d.Sort, Dir: d.Dir, Base: d.Base})
							<th scope="col">{ gui.T(ctx, "keys.col.detail") }</th>
							<th scope="col">{ gui.T(ctx, "keys.col.state") }</th>
							<th scope="col">{ gui.T(ctx, "keys.col.uses") }</th>
							<th scope="col"><span class="visually-hidden">{ gui.T(ctx, "keys.col.actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range d.Rows {
							<tr>
								<td><a class="w-cell-title w-mono w-nowrap" href={ templ.SafeURL(r.URL) }>{ r.Name }</a></td>
								<td class="w-nowrap">{ r.Type }</td>
								<td class="keys-detail">
									<span>{ r.Detail }</span>
									if r.Code != "" {
										<span class="keys-code w-mono">{ r.Code }</span>
									}
								</td>
								<td class="keys-state">@gui.StatusOf(r.State)</td>
								<td class="w-nowrap">{ r.Uses }</td>
								<td>
									if len(r.Actions) > 0 {
										@gui.Actions(gui.ActionsProps{ID: fmt.Sprintf("act-%d", r.ID), Name: r.Name, Items: r.Actions})
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if d.Pager != nil {
				<div class="keys-pager">@gui.Pager(d.Pager.Props(d.PagerHidden, d.Sizes, d.Size))</div>
			}
		}
	}
}

// filterBoxes: the checkboxes of one filter of the list, under its legend.
templ filterBoxes(legend string, boxes []box) {
	<fieldset class="w-fieldset w-field w-field--wide">
		<legend class="w-fieldset__legend">{ legend }</legend>
		<div class="w-checks">
			for _, b := range boxes {
				<label class="w-check"><input type="checkbox" name={ b.Name } value={ b.Value } checked?={ b.Checked }/> <span>{ b.Label }</span></label>
			}
		</div>
	</fieldset>
}

// detailView: the sheet of a key, in reading: its type and what it does,
// its value (never a secret: that it is set and, for AES, its size; for PGP,
// what the key says, then the public key in full, folded), and the rules
// whose tasks use it, each a link to its tasks.
templ detailView(d detailData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ gui.T(ctx, "keys.detail.title", "name", d.Name) }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.BackURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "keys.back") }
			</a>
			if d.EditURL != "" {
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.EditURL) }>
					@gui.Icon("pen")
					{ gui.T(ctx, "keys.action.edit") }
				</a>
			}
			if len(d.Actions) > 0 {
				@gui.Actions(gui.ActionsProps{ID: "act-detail", Name: d.Name, Items: d.Actions})
			}
		</div>
	</div>
	<div class="w-stack">
		<div class="w-card">
			<h2 class="w-card__title">{ gui.T(ctx, "keys.detail.card") }</h2>
			<dl class="w-deflist">
				<dt>{ gui.T(ctx, "keys.detail.type") }</dt>
				<dd>{ d.TypeLabel } <code class="w-code">{ d.TypeKey }</code></dd>
				if d.Role != "" {
					<dt>{ gui.T(ctx, "keys.detail.role") }</dt>
					<dd>{ d.Role }</dd>
				}
			</dl>
		</div>
		<div class="w-card">
			<h2 class="w-card__title">{ gui.T(ctx, "keys.detail.value") }</h2>
			<dl class="w-deflist">
				<dt>{ gui.T(ctx, "keys.detail.state") }</dt>
				<dd class="keys-state">@gui.StatusOf(d.State)</dd>
				if d.Info.Readable && d.Secret {
					<dt>{ gui.T(ctx, "keys.detail.value") }</dt>
					<dd>{ gui.T(ctx, "keys.secret_set") }</dd>
				}
				if d.Info.Readable && d.AESBits > 0 {
					<dt>{ gui.T(ctx, "keys.detail.size") }</dt>
					<dd>{ gui.T(ctx, "keys.detail.bits", "n", d.AESBits) }</dd>
				}
				if d.Info.Readable && d.PGP {
					<dt>{ gui.T(ctx, "keys.detail.identities") }</dt>
					<dd>@identities(d.Info.Identities)</dd>
					<dt>{ gui.T(ctx, "keys.detail.fingerprint") }</dt>
					<dd><code class="w-code">{ d.Info.Fingerprint }</code></dd>
					<dt>{ gui.T(ctx, "keys.detail.key_id") }</dt>
					<dd><code class="w-code">{ d.Info.KeyID }</code></dd>
					<dt>{ gui.T(ctx, "keys.detail.algorithm") }</dt>
					<dd>{ d.Info.Algorithm }</dd>
					<dt>{ gui.T(ctx, "keys.detail.created") }</dt>
					<dd>{ d.Created }</dd>
					<dt>{ gui.T(ctx, "keys.detail.expires") }</dt>
					<dd>{ d.Expires }</dd>
				}
			</dl>
			if d.Info.Public != "" {
				<details class="keys-public">
					<summary>@gui.Icon("chevron-right")<span>{ gui.T(ctx, "keys.detail.show_public") }</span></summary>
					<pre class="keys-armour">{ d.Info.Public }</pre>
				</details>
			}
		</div>
		<div class="w-card">
			<h2 class="w-card__title">{ gui.T(ctx, "keys.detail.uses") }</h2>
			@usesTable(d.Uses)
		</div>
	</div>
}

// identities: the user IDs of a PGP key, one per line, or "none".
templ identities(list []string) {
	if len(list) == 0 {
		<span class="w-muted">{ gui.T(ctx, "keys.detail.identities_none") }</span>
	} else {
		<ul class="keys-list">
			for _, id := range list {
				<li>{ id }</li>
			}
		</ul>
	}
}

// usesTable: the rules whose tasks name the key, each a link to the tasks of
// the rule (where the key is changed), with its direction; or the sentence
// saying no rule uses it.
templ usesTable(uses []useRow) {
	if len(uses) == 0 {
		<p class="keys-note w-muted">{ gui.T(ctx, "keys.detail.uses_none") }</p>
	} else {
		<div class="w-table-wrap keys-uses">
			<table class="w-table">
				<caption class="visually-hidden">{ gui.T(ctx, "keys.detail.uses_caption") }</caption>
				<thead>
					<tr>
						<th scope="col">{ gui.T(ctx, "keys.uses.rule") }</th>
						<th scope="col">{ gui.T(ctx, "keys.uses.direction") }</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range uses {
						<tr>
							<td><a class="w-link w-mono" href={ templ.SafeURL(u.URL) }>{ u.Rule }</a></td>
							<td>{ u.Direction }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// backLabel: the back button of the form: to the key on edition, to the
// list on creation.
templ backLabel(edit bool) {
	if edit {
		{ " " + gui.T(ctx, "keys.back_key") }
	} else {
		{ " " + gui.T(ctx, "keys.back") }
	}
}

// valueBlock: the value of one type of key, shown for the chosen type
// (data-case, unless the type is kept; every block rendered without
// JavaScript, the server reads the chosen one): a secret field for AES and
// HMAC, never filled; a file to upload or the armour to paste for PGP (the
// handler keeps the pasted armour of a public key only); what is in place on
// edition.
templ valueBlock(v valueView, switched bool) {
	<fieldset
		class="w-fieldset w-fieldset--wide"
		if switched {
			data-case={ v.Key }
		}
	>
		<legend class="visually-hidden">{ gui.T(ctx, valueKeyPrefix+v.Slug) }</legend>
		if !v.PGP {
			@protoform.FieldOf(protoform.FieldProps{ID: v.id(), Label: gui.T(ctx, valueKeyPrefix+v.Slug), Req: v.Current == "", F: protoform.Field{Error: v.Error}, Hint: valueHint(ctx, v), Password: true, Autocomplete: "new-password"})
		} else {
			<div class={ "w-field", templ.KV("is-invalid", v.Error != "") }>
				<label class="w-field__label" for={ v.fileID() }>{ gui.T(ctx, valueKeyPrefix+v.Slug) }@protoform.ReqMark(v.Current == "")</label>
				@gui.File(gui.FileProps{ID: v.fileID(), Name: v.fileID(), Current: v.Current, Accept: v.Accept, Describe: v.fileID() + "-h"})
				@protoform.Message(v.fileID()+"-h", v.Error, valueHint(ctx, v))
			</div>
			<div class="w-field">
				<label class="w-field__label" for={ v.textID() }>{ gui.T(ctx, pasteKeyPrefix+v.Slug) } <span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span></label>
				<textarea class="w-textarea w-mono" id={ v.textID() } name={ v.textID() } rows="5" spellcheck="false" autocomplete="off" placeholder={ gui.T(ctx, exampleKeyPrefix+v.Slug) }>{ v.Text }</textarea>
			</div>
		}
	</fieldset>
}

// valueHint: the format of the value for the type, or, on edition, that an
// empty one keeps what is in place.
func valueHint(ctx context.Context, v valueView) string {
	if v.Current != "" {
		return gui.T(ctx, keepKeyPrefix+v.Slug)
	}

	return gui.T(ctx, hintKeyPrefix+v.Slug)
}

// formView: creation and edition of a key, one page (decision D10), one
// card per block: the key (name, type; kept in reading when rules use it),
// its value (one block per type, switched by the type; for a key the rules
// use, the block of its type alone, nothing being required). Refused form: a
// banner, the name and type kept, the secrets to type again, a message under
// each faulty field (422).
templ formView(d *formData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				@backLabel(d.Edit)
			</a>
		</div>
	</div>
	if d.HasErrors {
		<div class="keys-banner">@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "keys.form.refused"), Text: protoform.Or(d.Refused, gui.T(ctx, "keys.form.refused_text"))})</div>
	}
	<form class="w-form" method="post" action={ templ.SafeURL(d.Action) } enctype="multipart/form-data" novalidate>
		<div class="w-card">
			<fieldset class="w-fieldset w-fieldset--wide">
				<legend class="w-card__title">{ gui.T(ctx, "keys.detail.card") }</legend>
				if d.Locked {
					<dl class="w-deflist">
						<dt>{ gui.T(ctx, "keys.form.name") }</dt>
						<dd><code class="w-code">{ d.Name.Value }</code></dd>
						<dt>{ gui.T(ctx, "keys.detail.type") }</dt>
						<dd>{ d.TypeLabel }</dd>
					</dl>
					<p class="keys-note w-muted">{ gui.T(ctx, "keys.form.locked", "rules", d.Rules) }</p>
				} else {
					<div class="w-grid w-grid--2">
						@protoform.FieldOf(protoform.FieldProps{ID: fieldName, Label: gui.T(ctx, "keys.form.name"), Req: true, F: d.Name, Hint: gui.T(ctx, "keys.form.name_hint")})
						<div class={ "w-field", templ.KV("is-invalid", d.TypeErr != "") }>
							<label class="w-field__label" for={ fieldType }>{ gui.T(ctx, "keys.form.type") } <span class="w-field__req" aria-hidden="true">*</span></label>
							<select
								class="w-select"
								id={ fieldType }
								name={ fieldType }
								required
								data-switch
								aria-describedby="type-h"
								if d.TypeErr != "" {
									aria-invalid="true"
								}
							>
								<option value="" selected?={ d.Type == "" }>{ gui.T(ctx, "keys.form.type_choose") }</option>
								for _, c := range d.Types {
									<option value={ c.Value } selected?={ c.Selected }>{ c.Label }</option>
								}
							</select>
							@protoform.Message("type-h", d.TypeErr, typeHint(ctx, d.Edit))
						</div>
					</div>
				}
			</fieldset>
		</div>
		<div class="w-card">
			<h2 class="w-card__title keys-card-title">{ gui.T(ctx, "keys.detail.value") } <span class="w-fold__meta">{ d.ValueSummary }</span></h2>
			for _, v := range d.Values {
				if !d.Locked {
					@valueBlock(v, true)
				} else if v.Key == d.Type {
					@valueBlock(v, false)
				}
			}
		</div>
		@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Required: !d.Locked, Title: d.Title})
	</form>
}

// typeHint: the hint of the type: what to choose, and on edition that a new
// type asks for a new value.
func typeHint(ctx context.Context, edit bool) string {
	if edit {
		return gui.T(ctx, "keys.form.type_hint_edit")
	}

	return gui.T(ctx, "keys.form.type_hint")
}

// deleteView: confirmation page of the deletion of a key (decision D10: a
// page, not a dialog), "Cancel" then "Delete" bottom right (D12). For a key
// the rules use, the "action impossible" page: why, the rules whose tasks to
// change first (links to their tasks), "Close" alone.
templ deleteView(d deleteData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "keys.back_key") }
			</a>
		</div>
	</div>
	<div class="w-card">
		if d.Used {
			<div class="keys-banner">@gui.Banner(gui.BannerProps{Kind: "warn", Title: gui.T(ctx, "keys.delete.used_title"), Text: gui.T(ctx, "keys.delete.used", "rules", d.Rules)})</div>
		} else {
			<p class="keys-lead">{ gui.T(ctx, "keys.delete.text") }</p>
		}
		<dl class="w-deflist">
			<dt>{ gui.T(ctx, "keys.col.name") }</dt>
			<dd><code class="w-code">{ d.Name }</code></dd>
			<dt>{ gui.T(ctx, "keys.detail.type") }</dt>
			<dd>{ d.TypeLabel }</dd>
			<dt>{ gui.T(ctx, "keys.col.detail") }</dt>
			<dd>{ d.Detail }</dd>
		</dl>
		if d.Used {
			<h2 class="w-card__title keys-subtitle">{ gui.T(ctx, "keys.detail.uses") }</h2>
			@usesTable(d.Uses)
			<div class="w-form__actions keys-form-actions"><a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>{ gui.T(ctx, "action.close") }</a></div>
		} else {
			<form class="keys-form-actions" method="post" action={ templ.SafeURL(d.Action) }>@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Danger: true, Title: d.Title})</form>
		}
	</div>
}

// notFoundView: a key that does not exist: localised 404 in the chrome, with
// the way back to the list as the user left it.
templ notFoundView(d notFoundData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
	</div>
	@gui.Empty(gui.EmptyProps{Icon: "key", Title: d.Text, Action: &gui.Link{Label: d.BackLabel, URL: d.BackURL, Icon: "arrow-left"}})
}
