package rules

import (
	"strconv"

	"code.waarp.fr/lib/gui"

	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/means"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/protoform"
)

// accessView: the Access tab of a rule. The state in words (open to all, or
// restricted and what that closes), then the access in two blocks: when a
// partner connects (servers, local accounts) and when the gateway connects
// (partners, remote accounts), each with a "⋯" menu to remove it. One
// coloured action: "Add an access".
templ accessView(d accessData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.BackURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "rules.back") }
			</a>
			if d.AddURL != "" {
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.AddURL) }>
					@gui.Icon("plus")
					{ gui.T(ctx, "rules.access.add") }
				</a>
			}
		</div>
	</div>
	@means.TabsNav(gui.T(ctx, "rules.tab.label"), d.Tabs)
	<div class="w-stack">
		<div class="w-card">
			<h2 class="w-card__title">{ gui.T(ctx, "rules.access.state") }</h2>
			if d.Open {
				<p class="rules-lead"><strong>{ gui.T(ctx, "rules.access.open") }</strong> · { gui.T(ctx, "rules.access.open_text") }</p>
			} else {
				<p class="rules-lead"><strong>{ gui.T(ctx, "rules.access.restricted_title") }</strong> · { gui.T(ctx, "rules.access.restricted_text") }</p>
				if d.OneSided != "" {
					<div class="rules-banner">@gui.Banner(gui.BannerProps{Kind: "warn", Title: gui.T(ctx, "rules.access.one_sided_title"), Text: d.OneSided})</div>
				}
				if d.OpenURL != "" {
					<div class="rules-card-actions"><a class="w-btn w-btn--outline-dark w-btn--sm" href={ templ.SafeURL(d.OpenURL) }>{ gui.T(ctx, "rules.access.open_action") }</a></div>
				}
			}
		</div>
		if !d.Open {
			@accessBlock(gui.T(ctx, "rules.access.in"), gui.T(ctx, "rules.access.in_text"), gui.T(ctx, "rules.access.in_none"), d.In)
			@accessBlock(gui.T(ctx, "rules.access.out"), gui.T(ctx, "rules.access.out_text"), gui.T(ctx, "rules.access.out_none"), d.Out)
		}
	</div>
}

// accessBlock: the access of one side, or the sentence saying it has none.
templ accessBlock(title, text, none string, rows []accessRow) {
	<div class="w-card">
		<h2 class="w-card__title">{ title }</h2>
		<p class="rules-hint rules-block-hint w-muted">{ text }</p>
		if len(rows) == 0 {
			<p class="rules-none w-muted">{ none }</p>
		} else {
			<div class="w-table-wrap">
				<table class="w-table">
					<caption class="visually-hidden">{ title }</caption>
					<colgroup><col class="rules-col-kind"/><col/><col class="rules-col-actions"/></colgroup>
					<thead>
						<tr>
							<th scope="col">{ gui.T(ctx, "rules.access.col.kind") }</th>
							<th scope="col">{ gui.T(ctx, "rules.access.col.target") }</th>
							<th scope="col"><span class="visually-hidden">{ gui.T(ctx, "rules.col.actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range rows {
							<tr>
								<td class="w-nowrap">{ r.Kind }</td>
								<td class="w-mono">{ r.Label }</td>
								<td>
									if len(r.Actions) > 0 {
										@gui.Actions(gui.ActionsProps{ID: "act-" + r.ID, Name: r.Label, Items: r.Actions})
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// accessFormView: the page that adds an access: the kind, then the target of
// that kind (one select per kind, shown for the chosen one; the accounts in
// groups by server or partner; the targets already granted left out).
templ accessFormView(d *accessForm) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ " " + gui.T(ctx, "rules.access.back") }
			</a>
		</div>
	</div>
	if d.HasErrors {
		<div class="rules-banner">@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "rules.access.refused"), Text: protoform.Or(d.Refused, gui.T(ctx, "rules.form.refused_text"))})</div>
	}
	<form class="w-form" method="post" action={ templ.SafeURL(d.Action) } novalidate>
		<div class="w-card">
			if d.Note != "" {
				<div class="rules-banner">@gui.Banner(gui.BannerProps{Kind: "warn", Title: gui.T(ctx, "rules.access.first_title"), Text: d.Note})</div>
			}
			<div class={ "w-field", templ.KV("is-invalid", d.KindErr != "") }>
				<label class="w-field__label" for={ fieldKind }>{ gui.T(ctx, "rules.access.col.kind") } <span class="w-field__req" aria-hidden="true">*</span></label>
				<select
					class="w-select"
					id={ fieldKind }
					name={ fieldKind }
					required
					data-switch
					aria-describedby="kind-h"
					if d.KindErr != "" {
						aria-invalid="true"
					}
				>
					<option value="" selected?={ d.Kind == "" }>{ gui.T(ctx, "rules.access.kind_choose") }</option>
					for _, k := range d.Kinds {
						<option value={ k.Value } selected?={ k.Selected }>{ k.Label }</option>
					}
				</select>
				@protoform.Message("kind-h", d.KindErr, gui.T(ctx, "rules.access.kind_hint"))
			</div>
			for _, k := range d.Kinds {
				<fieldset class="w-fieldset w-fieldset--wide" data-case={ k.Value }>
					<legend class="visually-hidden">{ k.Label }</legend>
					<div class={ "w-field", templ.KV("is-invalid", d.TargetErr != "" && k.Selected) }>
						<label class="w-field__label" for={ k.Value }>{ k.Label } <span class="w-field__req" aria-hidden="true">*</span></label>
						if k.Empty {
							<p class="w-muted">{ gui.T(ctx, "rules.access.none_left") }</p>
						} else {
							<select class="w-select" id={ k.Value } name={ k.Value } aria-describedby={ k.Value + "-h" }>
								<option value="">{ gui.T(ctx, "rules.access.target_choose") }</option>
								for _, g := range k.Groups {
									if g.Label == "" {
										for _, o := range g.Options {
											<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
										}
									} else {
										<optgroup label={ g.Label }>
											for _, o := range g.Options {
												<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
											}
										</optgroup>
									}
								}
							</select>
						}
						if k.Selected {
							@protoform.Message(k.Value+"-h", d.TargetErr, "")
						}
					</div>
				</fieldset>
			}
		</div>
		@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Required: true, Title: d.Title})
	</form>
}

// removeView: confirmation page of the removal of an access (decision D10),
// saying when the rule becomes open to all again.
templ removeView(d removeData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "rules.access.back") }
			</a>
		</div>
	</div>
	<div class="w-card">
		if d.Last {
			<div class="rules-banner">@gui.Banner(gui.BannerProps{Kind: "warn", Title: gui.T(ctx, "rules.access.last_title"), Text: gui.T(ctx, "rules.access.last_text")})</div>
		} else {
			<p class="rules-lead">{ gui.T(ctx, "rules.access.remove_text") }</p>
		}
		<dl class="w-deflist">
			<dt>{ gui.T(ctx, "rules.access.col.kind") }</dt>
			<dd>{ d.Kind }</dd>
			<dt>{ gui.T(ctx, "rules.access.col.target") }</dt>
			<dd><code class="w-code">{ d.Label }</code></dd>
		</dl>
		<form class="rules-form-actions" method="post" action={ templ.SafeURL(d.Action) }>@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Danger: true, Title: d.Title})</form>
	</div>
}

// openView: confirmation page that opens the rule to all again: every access
// removed.
templ openView(d openData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "rules.access.back") }
			</a>
		</div>
	</div>
	<div class="w-card">
		<p class="rules-lead">{ gui.T(ctx, "rules.access.open_confirm", "n", strconv.Itoa(d.Count)) }</p>
		<form class="rules-form-actions" method="post" action={ templ.SafeURL(d.Action) }>@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Title: d.Title})</form>
	</div>
}
