package rules

import (
	"strconv"

	"code.waarp.fr/lib/gui"

	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/means"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/protoform"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/transfers"
)

// tasksView: the Tasks tab of a rule (prototype validated by Driss on
// 2026-10-23): the header holds the menu of the rule, not its edition; the
// three chains (before the transfer, after it, on error) side by side, as
// foldable cards that stay folded on the next visit; each task a card in its
// chain, titled by its type, its label and what it does in a tooltip, its
// parameters under it, its "⋯" menu. "Add a task" heads each chain. No
// coloured action: three chains, three neutral buttons.
templ tasksView(d tasksData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.BackURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "rules.back") }
			</a>
			if len(d.Actions) > 0 {
				@gui.Actions(gui.ActionsProps{ID: "act-tasks", Name: d.Title, Items: d.Actions})
			}
		</div>
	</div>
	@means.TabsNav(gui.T(ctx, "rules.tab.label"), d.Tabs)
	<p class="rules-hint w-muted rules-chains-hint">{ gui.T(ctx, "rules.tasks.order_hint") }</p>
	<div class="w-grid w-grid--3 rules-columns">
		for _, c := range d.Chains {
			@chainBlock(c)
		}
	</div>
}

// chainBlock: a chain, its number of tasks in its head, "Add a task", then
// its tasks in order, folded (Driss, 2026-10-23: the name alone on arrival;
// the chevron shows the parameters; an object the gateway no longer has is
// said on the folded task). With the write right and two tasks or more, each
// task has its grip and the chain is ordered again by dragging them (or with
// the arrows on a grip), then saved with "Save the order"; "Move up" and
// "Move down" stay in the menu of each task, without JavaScript too.
templ chainBlock(c chainView) {
	@ruleFold("chain-"+c.Slug, c.Title, c.Count) {
		if c.AddURL != "" {
			<div class="rules-card-actions rules-add">
				<a class="w-btn w-btn--outline-dark w-btn--sm" href={ templ.SafeURL(c.AddURL) }>
					@gui.Icon("plus")
					{ gui.T(ctx, "rules.tasks.add") }<span class="visually-hidden">{ " " + c.Lower }</span>
				</a>
			</div>
		}
		if len(c.Rows) == 0 {
			<p class="rules-none w-muted">{ gui.T(ctx, "rules.tasks.none") }</p>
		} else {
			if c.OrderURL != "" {
				@gui.SortableBar(gui.SortableBarProps{ID: c.OrderID, Action: c.OrderURL})
			}
			<ol
				class="w-sortable rules-tasklist"
				aria-label={ c.Title }
				if c.OrderURL != "" {
					data-sortable={ c.OrderID }
				}
			>
				for _, r := range c.Rows {
					<li class="w-sortable__item" data-sortable-name={ r.Code }>
						if c.OrderURL != "" {
							@gui.SortableGrip(r.Code)
						}
						<span class="w-sortable__rank" data-sortable-rank>{ strconv.Itoa(r.Rank) }</span>
						<div class="w-sortable__body rules-taskhead">
							if len(r.Args) > 0 {
								<details class="rules-taskfold">
									<summary>
										@gui.Icon("chevron-right")
										@taskName(r)
									</summary>
									@argList(r.Args)
								</details>
							} else {
								<p class="rules-taskfold rules-taskfold--empty">
									@taskName(r)
								</p>
							}
							if r.Tip != "" {
								@taskTip(r.Code, r.Tip)
							}
							if c.OrderURL != "" {
								<input type="hidden" name={ orderField } value={ strconv.Itoa(r.Rank - 1) } form={ c.OrderID }/>
							}
						</div>
						if len(r.Actions) > 0 {
							@gui.Actions(gui.ActionsProps{ID: "act-" + r.ID, Name: r.Code, Items: r.Actions})
						}
					</li>
				}
			</ol>
		}
	}
}

// taskName: the name of a task in its chain, its type, with what the folded
// task must say: a type this screen does not know, an object the gateway no
// longer has.
templ taskName(r taskRow) {
	<strong class="rules-taskname">{ r.Code }</strong>
	if r.Unknown {
		{ " " }
		@gui.StatusOf(gui.Status{State: "warn", Label: gui.T(ctx, "rules.tasks.unknown_type")})
	}
	if r.Missing {
		{ " " }
		@gui.StatusOf(gui.Status{State: "warn", Label: gui.T(ctx, "rules.tasks.missing_status")})
	}
}

// argList: the parameters of a task, one label and its value a line; an
// object the gateway does not have is marked, with the screen of its kind.
templ argList(args []argView) {
	<dl class="rules-args">
		for _, a := range args {
			<dt>{ a.Label }</dt>
			<dd>
				<span class="rules-value">{ a.Value }</span>
				if a.Missing {
					{ " " }
					@gui.StatusOf(gui.Status{State: "warn", Label: gui.T(ctx, "rules.tasks.missing_status")})
					if a.ScreenURL != "" {
						{ " " }<a href={ templ.SafeURL(a.ScreenURL) }>{ a.ScreenLabel }</a>
					}
				}
			</dd>
		}
	</dl>
}

// taskFormView: the page of a task, one page: the type (a new task: a list
// by family, whose choice shows the cards of its parameters; a task edited:
// its type in reading), then the cards of the type, then "Cancel" and "Save".
templ taskFormView(d *taskFormData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "rules.tasks.back") }
			</a>
		</div>
	</div>
	if d.HasErrors {
		<div class="rules-banner">@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "rules.tasks.refused"), Text: protoform.Or(d.Refused, gui.T(ctx, "rules.tasks.refused_text"))})</div>
	}
	<form class="w-form rules-taskform" method="post" action={ templ.SafeURL(d.Action) } novalidate>
		if d.Ret != "" {
			<input type="hidden" name="ret" value={ d.Ret }/>
		}
		<div class="w-stack">
			@typeCard(d)
			if d.Unknown != "" {
				@gui.Banner(gui.BannerProps{Kind: "warn", Title: d.Unknown})
			}
			for _, b := range d.Blocks {
				@typePart(b, b.Before)
			}
			if d.Infos != nil {
				@infosCard(d.Infos)
			}
			for _, b := range d.Blocks {
				if len(b.After) > 0 {
					@typePart(b, b.After)
				}
			}
		</div>
		@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Required: d.Required, Title: d.Title})
	</form>
}

// taskFormHead: what the page of a task loads besides the kit: the list to
// type in (the type), the typed fields.
templ taskFormHead() {
	@gui.ComboboxAssets()
	@gui.CheckAssets()
}

// typeCard: the type of the task. A new one: the list to type in, by family,
// each type with its label in bold, its code and what it does, which switches
// the cards of the types (data-switch); "Continue" without JavaScript; under
// the list, the type chosen with what it does in a tooltip. A task edited:
// its type, kept.
templ typeCard(d *taskFormData) {
	<div class="w-card">
		if d.Edit {
			<h2 class="w-card__title">{ gui.T(ctx, "rules.tasks.type") }</h2>
			<p class="rules-taskname">
				<strong>{ d.Type }</strong>
				@taskTip(d.Type, d.TypeTip)
			</p>
			<p class="rules-none rules-hint w-muted">{ gui.T(ctx, "rules.tasks.type_kept") }</p>
			<input type="hidden" name={ fieldType } value={ d.Type }/>
		} else {
			<div class={ "w-field", templ.KV("is-invalid", d.TypeErr != "") }>
				<label class="w-field__label" for={ fieldType }>{ gui.T(ctx, "rules.tasks.type") } <span class="w-field__req" aria-hidden="true">*</span></label>
				@gui.Combobox(gui.ComboboxProps{
					ID: fieldType, Name: fieldType, Groups: d.Families, Placeholder: gui.T(ctx, "rules.tasks.type_choose"),
					Required: true, Invalid: d.TypeErr != "", Describe: "type-h", Switch: "type",
				})
				@protoform.Message("type-h", d.TypeErr, gui.T(ctx, "rules.tasks.type_hint"))
				<noscript>
					<button class="w-btn w-btn--outline-dark w-btn--sm rules-noscript" type="submit" formmethod="get" formaction={ templ.SafeURL(d.NewURL) } formnovalidate>{ gui.T(ctx, "rules.tasks.continue") }</button>
				</noscript>
			</div>
			for _, b := range d.Blocks {
				<p class="rules-taskname rules-typeinfo" data-case={ b.Type } data-of="type" hidden?={ !b.Active }>
					<strong>{ b.Label }</strong>
					{ " " }
					<code class="w-code">{ b.Type }</code>
					@taskTip(b.Type, b.Tip)
				</p>
			}
		}
	</div>
}

// taskTip: the button whose tooltip says what a type of task does.
templ taskTip(code, tip string) {
	<button class="w-icon-btn rules-info" type="button" title={ tip } aria-label={ gui.T(ctx, "rules.tasks.explain", "name", code) }>
		@gui.Icon("info")
	</button>
}

// typePart: cards of a type, shown and sent only for the type chosen.
templ typePart(b typeBlock, groups []groupView) {
	<fieldset class="w-fieldset w-fieldset--wide rules-case" data-case={ b.Type } data-of="type" hidden?={ !b.Active } disabled?={ !b.Active }>
		<legend class="visually-hidden">{ b.Label }</legend>
		<div class="w-stack">
			for _, g := range groups {
				@groupCard(g)
			}
		</div>
	</fieldset>
}

// groupCard: a card of parameters, side by side; a titled card folds (Driss,
// 2026-10-23), open as the page comes, so that nothing typed nor refused is
// ever hidden from the user.
templ groupCard(g groupView) {
	if g.Title == "" {
		<div class="w-card">
			<fieldset class="w-fieldset w-fieldset--wide">
				@groupContent(g)
			</fieldset>
		</div>
	} else {
		<details class="w-card w-card--fold" open>
			<summary>
				@gui.Icon("chevron-right")
				<h2 class="w-card__title">{ g.Title }</h2>
			</summary>
			<div class="w-card__body">
				<fieldset class="w-fieldset w-fieldset--wide">
					<legend class="visually-hidden">{ g.Title }</legend>
					@groupContent(g)
				</fieldset>
			</div>
		</details>
	}
}

// groupContent: what a card of parameters holds.
templ groupContent(g groupView) {
	if g.Note != "" {
		<p class="w-muted rules-note">{ g.Note }</p>
	}
	switch {
		case g.Empty:
			<p class="rules-none w-muted">{ gui.T(ctx, "rules.tasks.no_args") }</p>
		case g.Exchange != nil:
			@exchangeFields(g.Exchange)
		default:
			<div class={ "w-grid", templ.KV("w-grid--3", g.Columns == threeColumns), templ.KV("w-grid--2", g.Columns != threeColumns) }>
				for _, f := range g.Fields {
					@taskField(f)
				}
			</div>
	}
}

// exchangeFields: the exchange of a TRANSFER task, as the page that adds a
// transfer asks it: the direction, then the rules of that direction (a list
// per direction, switched by it), the partner and its account, the client.
templ exchangeFields(x *exchangeView) {
	<div class="w-grid w-grid--2">
		<div class="rules-span">
			@choiceButtons(fieldView{
				ID: x.Slug + "-" + exchangeSens, Name: x.Slug + "." + exchangeSens, Label: gui.T(ctx, "task_types.transfer.sens_label"),
				Hint: gui.T(ctx, "task_types.transfer.sens_hint"), Error: x.SensErr, Required: true, Options: x.Senses,
				Switch: x.Slug + "-" + exchangeSens,
			})
		</div>
		<div>
			<fieldset class="w-fieldset rules-switched" data-case="" data-of={ x.Slug + "-" + exchangeSens } hidden disabled>
				<div class="w-field">
					<label class="w-field__label" for={ x.Slug + "-rule-none" }>{ gui.T(ctx, "task_types.transfer.arg.rule.label") }@argMark(true, false)</label>
					<select class="w-select" id={ x.Slug + "-rule-none" } disabled>
						<option value="">{ gui.T(ctx, "task_types.transfer.rule_none") }</option>
					</select>
					<span class="w-field__hint">{ gui.T(ctx, "task_types.transfer.arg.rule.hint") }</span>
				</div>
			</fieldset>
			for _, rc := range x.Rules {
				<fieldset class="w-fieldset rules-switched" data-case={ rc.Sens } data-of={ x.Slug + "-" + exchangeSens }>
					@taskField(fieldView{
						ID: rc.ID, Name: rc.Name, Kind: fieldSelect, Label: gui.T(ctx, "task_types.transfer.arg.rule.label"),
						Hint: gui.T(ctx, "task_types.transfer.arg.rule.hint"), Error: x.RuleErr, Required: true, None: rc.None, Groups: rc.Groups,
					})
				</fieldset>
			}
		</div>
		@taskField(fieldView{
			ID: x.Slug + "-" + exchangeAccount, Name: x.Slug + "." + exchangeAccount, Kind: fieldSelect,
			Label: gui.T(ctx, "transfers.form.remote_account"), Hint: gui.T(ctx, "transfers.form.remote_account_hint"),
			Error: x.AccountErr, Required: true, None: gui.T(ctx, "transfers.form.choose_account"), Groups: x.Accounts,
		})
		@taskField(x.Client)
	</div>
}

// infosCard: the transfer information of TRANSFER and PREREGISTER, one card
// for both, shown and sent for them only: the copy of the information of the
// transfer under way, then the rows of the page that adds a transfer.
templ infosCard(x *infosView) {
	<fieldset class="w-fieldset w-fieldset--wide rules-case" data-case={ x.Cases } data-of="type" hidden?={ !x.Active } disabled?={ !x.Active }>
		<legend class="visually-hidden">{ gui.T(ctx, "transfers.detail.infos") }</legend>
		<details class="w-card w-card--fold" open>
			<summary>
				@gui.Icon("chevron-right")
				<h2 class="w-card__title">{ gui.T(ctx, "transfers.detail.infos") }</h2>
			</summary>
			<div class="w-card__body">
				<div class="w-field rules-copyinfo">
					<label class="w-check"><input type="checkbox" id="info-copy" name={ fieldInfoCopy } value="true" checked?={ x.Copy } aria-describedby="info-copy-h"/> <span>{ gui.T(ctx, "rules.tasks.info_copy") }</span></label>
					<span class="w-field__hint" id="info-copy-h">{ gui.T(ctx, "rules.tasks.info_copy_hint") }</span>
				</div>
				@transfers.InfoList(x.Rows, x.Error)
			</div>
		</details>
	</fieldset>
}

// argMark: what follows the label of a parameter: the required star, or
// "(optional)"; nothing for a choice always made.
templ argMark(required, none bool) {
	if none {
	} else if required {
		{ " " }<span class="w-field__req" aria-hidden="true">*</span>
	} else {
		{ " " }<span class="w-field__opt">{ gui.T(ctx, "form.optional") }</span>
	}
}

// taskField: a parameter of the task, as its kind asks; a parameter that
// depends on another one sits in the block that switch shows.
templ taskField(f fieldView) {
	if f.CaseOf != "" {
		<fieldset class={ "w-fieldset", "rules-switched", templ.KV("rules-span", f.Wide) } data-case={ f.CaseValue } data-of={ f.CaseOf }>
			@argInput(f)
		</fieldset>
	} else if f.Wide {
		<div class="rules-span">
			@argInput(f)
		</div>
	} else {
		@argInput(f)
	}
}

// argInput: the field of a parameter.
templ argInput(f fieldView) {
	switch f.Kind {
		case fieldText, fieldDecimal, fieldNumber:
			<div class={ "w-field", templ.KV("w-field--short", f.Kind != fieldText), templ.KV("is-invalid", f.Error != "") }>
				<label class="w-field__label" for={ f.ID }>{ f.Label }@argMark(f.Required, false)</label>
				<input
					class="w-input"
					id={ f.ID }
					name={ f.Name }
					value={ f.Value }
					if f.Kind == fieldNumber {
						type="number"
						inputmode="numeric"
						step="1"
						min={ strconv.Itoa(f.Min) }
						if f.Max > 0 {
							max={ strconv.Itoa(f.Max) }
						}
					}
					required?={ f.Required }
					aria-describedby={ f.ID + "-h" }
					if f.Error != "" {
						aria-invalid="true"
					}
					if f.Check != "" {
						{ f.Check.Attributes(ctx)... }
						data-hint={ f.Hint }
					}
				/>
				@protoform.Message(f.ID+"-h", f.Error, f.Hint)
			</div>
		case fieldBool:
			<div class={ "w-field", templ.KV("is-invalid", f.Error != "") }>
				<label class="w-check"><input type="checkbox" id={ f.ID } name={ f.Name } value="true" checked?={ f.Checked } aria-describedby={ f.ID + "-h" }/> <span>{ f.Label }</span></label>
				@protoform.Message(f.ID+"-h", f.Error, f.Hint)
			</div>
		case fieldChoice:
			@choiceButtons(f)
		case fieldFixed:
			<div class="w-field">
				<span class="w-field__label">{ f.Label }</span>
				<p class="rules-fixed"><code class="w-code">{ f.Fixed }</code> <span class="w-muted">{ gui.T(ctx, "rules.tasks.fixed") }</span></p>
				<input type="hidden" name={ f.Name } value={ f.Value }/>
			</div>
		case fieldSelect:
			<div class={ "w-field", templ.KV("is-invalid", f.Error != "") }>
				<label class="w-field__label" for={ f.ID }>{ f.Label }@argMark(f.Required, false)</label>
				<select
					class="w-select"
					id={ f.ID }
					name={ f.Name }
					required?={ f.Required }
					aria-describedby={ f.ID + "-h" }
					if f.Error != "" {
						aria-invalid="true"
					}
				>
					<option value="">{ f.None }</option>
					for _, g := range f.Groups {
						if g.Label == "" {
							for _, o := range g.Options {
								<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
							}
						} else {
							<optgroup label={ g.Label }>
								for _, o := range g.Options {
									<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
								}
							</optgroup>
						}
					}
				</select>
				@protoform.Message(f.ID+"-h", f.Error, f.Hint)
			</div>
		default:
			<div class={ "w-field", templ.KV("is-invalid", f.Error != "") }>
				<label class="w-field__label" for={ f.ID }>{ f.Label }@argMark(f.Required, false)</label>
				<textarea
					class="w-textarea w-mono"
					id={ f.ID }
					name={ f.Name }
					rows={ strconv.Itoa(f.Rows) }
					spellcheck="false"
					aria-describedby={ f.ID + "-h" }
					if f.Error != "" {
						aria-invalid="true"
					}
				>{ f.Value }</textarea>
				@protoform.Message(f.ID+"-h", f.Error, f.Hint)
			</div>
	}
}

// choiceButtons: two or three values as joined buttons (w-segmented of the
// kit): radio buttons, the checked one with its border, its weight and its
// check; a switch for the fields that depend on it.
templ choiceButtons(f fieldView) {
	<fieldset class={ "w-fieldset", "rules-choice", templ.KV("is-invalid", f.Error != "") } aria-describedby={ f.ID + "-h" }>
		<legend class="w-field__label">{ f.Label }@argMark(f.Required, f.NoMark)</legend>
		<div class="w-segmented">
			for _, o := range f.Options {
				<label>
					<input
						type="radio"
						name={ f.Name }
						value={ o.Value }
						checked?={ o.Selected }
						required?={ f.Required }
						if f.Switch != "" {
							data-switch={ f.Switch }
						}
					/>
					<span>
						@gui.Icon("check")
						{ o.Label }
					</span>
				</label>
			}
		</div>
		@protoform.Message(f.ID+"-h", f.Error, f.Hint)
	</fieldset>
}

// taskDeleteView: confirmation page of the removal of a task (decision D10):
// the task and its parameters, then what moves.
templ taskDeleteView(d taskDeleteData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "rules.tasks.back") }
			</a>
		</div>
	</div>
	<div class="w-card">
		<p class="rules-lead">{ gui.T(ctx, "rules.tasks.delete_text") }</p>
		<dl class="w-deflist">
			<dt>{ gui.T(ctx, "rules.tasks.col.type") }</dt>
			<dd>{ d.Label } <code class="w-code">{ d.Code }</code></dd>
			if len(d.Args) > 0 {
				<dt>{ gui.T(ctx, "rules.tasks.col.args") }</dt>
				<dd>@argList(d.Args)</dd>
			}
		</dl>
		<form class="rules-form-actions" method="post" action={ templ.SafeURL(d.Action) }>@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Danger: true, Title: d.Title})</form>
	</div>
}
