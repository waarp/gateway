package users

import (
	"fmt"

	"code.waarp.fr/lib/gui"

	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/liststate"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/protoform"
	"code.waarp.fr/apps/gateway/gateway/pkg/admin/gui/v2/backend/handlers/rights"
)

// listView: the users list (Administration). Presentation only: the handler
// searches, filters, sorts and pages the rows, builds the row actions from
// the rights and translates the texts. One coloured action ("Add a user");
// search and filters neutral, the filters (a domain, a right held) applied
// as soon as they change (data-autosubmit, "Apply" only without JavaScript);
// seven sortable headers; the rights of a user in the notation of the
// product, one column per domain, with a legend under the table; the
// signed-in user marked "You"; a "⋯" menu per row; rows per page in the
// list foot.
templ listView(d listData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ gui.T(ctx, "users.title") }</h1>
		</div>
		if d.AddURL != "" {
			<div class="w-page-header__actions">
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.AddURL) }>
					@gui.Icon("plus")
					{ gui.T(ctx, "users.add") }
				</a>
			</div>
		}
	</div>
	if d.Error {
		@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "users.error.title"), Text: gui.T(ctx, "users.error.text"), Action: &gui.Link{Label: gui.T(ctx, "action.retry"), URL: d.RetryURL}})
	} else if d.Empty {
		@gui.Empty(gui.EmptyProps{Icon: "users", Title: gui.T(ctx, "users.empty.title"), Text: gui.T(ctx, "users.empty.text"), Action: liststate.AddLink(d.AddURL, gui.T(ctx, "users.add"))})
	} else {
		<div data-live data-live-period="0">
			<form class="w-toolbar" role="search" method="get" action={ templ.SafeURL(d.Action) } data-autosubmit data-live-filter>
				for _, h := range liststate.SortedHidden(d.Hidden) {
					<input type="hidden" name={ h.Name } value={ h.Value }/>
				}
				<label class="w-search"><span class="visually-hidden">{ gui.T(ctx, "users.search") }</span>@gui.Icon("search")<input type="search" name="q" value={ d.Q } placeholder={ gui.T(ctx, "users.search_placeholder") } title={ gui.T(ctx, "lists.search_hint") } list="users-logins" autocomplete="off"/></label>
				<datalist id="users-logins">
					for _, n := range d.Names {
						<option value={ n }></option>
					}
				</datalist>
				<details class="w-disclose" open?={ d.FiltersOpen }>
					<summary class="w-btn w-btn--outline-dark w-btn--sm">
						@gui.Icon("filter")
						<span id="users-filters" data-live-part="list">{ gui.T(ctx, "filters.title") + liststate.CountSuffix(d.FiltersCount) }</span>
					</summary>
					<div class="w-disclose__panel">
						<div class="w-field w-field--medium">
							<label class="w-field__label" for="domain">{ gui.T(ctx, "users.filter.domain") }</label>
							<select class="w-select" id="domain" name="domain">
								for _, c := range d.Domains {
									<option value={ c.Value } selected?={ c.Selected }>{ c.Label }</option>
								}
							</select>
						</div>
						<div class="w-field w-field--medium">
							<label class="w-field__label" for="right">{ gui.T(ctx, "users.filter.right") }</label>
							<select class="w-select" id="right" name="right">
								for _, c := range d.Rights {
									<option value={ c.Value } selected?={ c.Selected }>{ c.Label }</option>
								}
							</select>
						</div>
						@gui.FiltersFoot(d.ResetURL)
					</div>
				</details>
				<span class="w-toolbar__spacer"></span>
				<span class="w-toolbar__count" id="users-count" data-live-part="list" aria-live="polite">{ d.Count }</span>
			</form>
			@listRegion(d)
			<template data-live-error>@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "users.error.title"), Text: gui.T(ctx, "users.error.text"), Action: &gui.Link{Label: gui.T(ctx, "action.retry"), URL: d.Action}})</template>
		</div>
	}
}

// listRegion: the region of the list, the part "list" of the live list of
// the kit (with the count of the toolbar): read and put in place as the
// filters, the sort or the page change (#766).
templ listRegion(d listData) {
	<div id="users-list" data-live-part="list" data-live-paged>
		if d.NoMatch {
			@gui.Empty(gui.EmptyProps{Icon: "search", Title: d.NoMatchText, Action: &gui.Link{Label: d.NoMatchLink, URL: d.NoMatchURL}})
		} else {
			<div class="w-table-wrap">
				<table class="w-table">
					<caption class="visually-hidden">{ d.Caption }</caption>
					<colgroup>
						<col class="users-col-name"/>
						for range d.Columns {
							<col class="users-col-rights"/>
						}
						<col class="users-col-actions"/>
					</colgroup>
					<thead>
						<tr>
							@gui.Th(gui.ThProps{Label: gui.T(ctx, "users.col.name"), Key: "name", Sort: d.Sort, Dir: d.Dir, Base: d.Base})
							for _, c := range d.Columns {
								@gui.Th(gui.ThProps{Label: c.Label, Key: c.Key, Sort: d.Sort, Dir: d.Dir, Base: d.Base})
							}
							<th scope="col"><span class="visually-hidden">{ gui.T(ctx, "users.col.actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range d.Rows {
							<tr>
								<td><a class="w-cell-title w-nowrap" href={ templ.SafeURL(r.URL) }>{ r.Name }</a>@youBadge(r.Self)</td>
								for _, l := range r.Letters {
									<td><span class="w-mono">{ l }</span></td>
								}
								<td>@gui.Actions(gui.ActionsProps{ID: fmt.Sprintf("act-%d", r.ID), Name: r.Name, Items: r.Actions})</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="users-legend w-muted">{ gui.T(ctx, "users.legend") }</p>
			if d.Pager != nil {
				<div class="users-pager">@gui.Pager(d.Pager.Props(d.PagerHidden, d.Sizes, d.Size))</div>
			}
		}
	</div>
}

// listFragment: what ?fragment=list serves to the live list of the kit: the
// elements of the part "list", with the ids of the page, without the shell.
templ listFragment(d listData) {
	<span id="users-filters" data-live-part="list">{ gui.T(ctx, "filters.title") + liststate.CountSuffix(d.FiltersCount) }</span>
	<span class="w-toolbar__count" id="users-count" data-live-part="list" aria-live="polite">{ d.Count }</span>
	@listRegion(d)
}

// youBadge: the "You" mark of the signed-in user, after their login.
templ youBadge(self bool) {
	if self {
		{ " " }<span class="w-badge w-badge--neutral">{ gui.T(ctx, "users.you") }</span>
	}
}

// detailView: the sheet of a user, in reading: the login (marked "You" for
// the signed-in user, "last administrator" when they are the only one who
// may manage the users) and the rights by domain, the cards shared with "My
// account". Breadcrumb and a "Back to the list" button (decision D10);
// "Edit" as the main action, the deletion in a "⋯" menu.
templ detailView(d detailData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ gui.T(ctx, "users.detail.title", "name", d.Name) }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.BackURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "users.back") }
			</a>
			if d.EditURL != "" {
				<a class="w-btn w-btn--primary" href={ templ.SafeURL(d.EditURL) }>
					@gui.Icon("pen")
					{ gui.T(ctx, "users.action.edit") }
				</a>
			}
			if len(d.Actions) > 0 {
				@gui.Actions(gui.ActionsProps{ID: "act-detail", Name: d.Name, Items: d.Actions})
			}
		</div>
	</div>
	<div class="w-stack">
		<div class="w-card">
			<h2 class="w-card__title">{ gui.T(ctx, "users.detail.card") }</h2>
			<dl class="w-deflist">
				<dt>{ gui.T(ctx, "users.detail.login") }</dt>
				<dd><code class="w-code">{ d.Name }</code>@youBadge(d.Self)</dd>
			</dl>
			if d.LastAdmin {
				<p class="users-note">{ gui.T(ctx, "users.last_admin") }</p>
			}
		</div>
		// The second card folds, closed by default and summed up in its heading
		// (#810); the kit keeps the state the user chose.
		<details class="w-card w-card--fold" data-key="users-rights">
			<summary>@gui.Icon("chevron-right")<span class="w-card__title">{ gui.T(ctx, "users.detail.rights") }</span><span class="w-fold__meta">{ d.RightsMeta }</span></summary>
			<div class="w-card__body">
				@rights.List(d.Caption, d.Rights)
			</div>
		</details>
	</div>
}

// backLabel: the label of the back button of the form: to the user on
// edition, to the list on creation.
templ backLabel(edit bool) {
	if edit {
		{ " " + gui.T(ctx, "users.back_user") }
	} else {
		{ " " + gui.T(ctx, "users.back") }
	}
}

// selfWarning: on the signed-in user's own form, the rights apply as soon as
// the form is saved; the last administrator is told what dropping the write
// right on the users means.
templ selfWarning(d *formData) {
	if d.Self {
		<div class="users-banner">
			if d.LastAdmin {
				@gui.Banner(gui.BannerProps{Kind: "warn", Icon: "info", Title: gui.T(ctx, "users.form.self"), Text: " " + gui.T(ctx, "users.form.self_last_admin")})
			} else {
				@gui.Banner(gui.BannerProps{Kind: "warn", Icon: "info", Title: gui.T(ctx, "users.form.self")})
			}
		</div>
	}
}

// rightCheck: one checkbox of the rights, named after its domain with the
// letter of the right as its value, as the product writes the rights; its
// label says the right, the legend of its card the domain.
templ rightCheck(key, letter string, checked bool, label string) {
	<label class="w-check"><input type="checkbox" id={ key + "-" + letter } name={ key } value={ letter } checked?={ checked }/> <span>{ label }</span></label>
}

// rightsChecks: the rights to grant, one card per domain as on the sheet (no
// table in a card: Driss, 2026-10-23), a checkbox for the read, write and
// delete rights; the transfers have no delete right (the product never
// checks it), the note under the cards says so.
templ rightsChecks(d *formData) {
	<div class="rights-list" role="group" aria-label={ gui.T(ctx, "users.form.rights_caption") }>
		for _, row := range d.Rights {
			<fieldset class="rights-item">
				<legend class="rights-domain">{ row.Label }</legend>
				<div class="w-checks">
					@rightCheck(row.Key, "r", row.Read, gui.T(ctx, "rights.col.read"))
					@rightCheck(row.Key, "w", row.Write, gui.T(ctx, "rights.col.write"))
					if !row.NoDelete {
						@rightCheck(row.Key, "d", row.Delete, gui.T(ctx, "rights.col.delete"))
					}
				</div>
			</fieldset>
		}
	</div>
	<p class="w-form__note users-note">{ gui.T(ctx, "users.form.transfers_delete") }</p>
}

// formView: creation and edition of a user, one page (decision D10), one
// card per block: the identity (login, password entered twice and checked by
// the server, never rendered back; optional on edition, empty meaning
// unchanged) and the rights, a card of checkboxes per domain. Refused form: a
// banner, the login and the checkboxes kept, a message under each faulty
// field (422).
templ formView(d *formData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				@backLabel(d.Edit)
			</a>
		</div>
	</div>
	if d.HasErrors {
		<div class="users-banner">@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "users.form.refused"), Text: protoform.Or(d.Refused, gui.T(ctx, "users.form.refused_text"))})</div>
	}
	@selfWarning(d)
	<form class="w-form" method="post" action={ templ.SafeURL(d.Action) } novalidate>
		<div class="w-card">
			<fieldset class="w-fieldset w-fieldset--wide">
				<legend class="w-card__title">{ gui.T(ctx, "users.form.identity") }</legend>
				<div class="w-grid w-grid--3">
					@protoform.FieldOf(protoform.FieldProps{ID: fieldLogin, Label: gui.T(ctx, "users.form.login"), Req: true, F: d.Fields[fieldLogin], Hint: gui.T(ctx, "users.form.login_hint"), Autocomplete: "username"})
					@protoform.FieldOf(protoform.FieldProps{ID: fieldPassword, Label: gui.T(ctx, "users.form.password"), Req: !d.Edit, F: d.Fields[fieldPassword], Hint: d.PasswordHint, Password: true, Autocomplete: "new-password"})
					@protoform.FieldOf(protoform.FieldProps{ID: fieldConfirm, Label: gui.T(ctx, "users.form.confirm"), Req: !d.Edit, F: d.Fields[fieldConfirm], Password: true, Autocomplete: "new-password"})
				</div>
			</fieldset>
		</div>
		// The rights card folds (rule of 2026-10-25, #807): open by default,
		// its state kept by the kit; no key while the form is refused, so
		// that it opens on the error.
		<details
			class="w-card w-card--fold"
			if !d.HasErrors {
				data-key="users-form-rights"
			}
			open
		>
			<summary>@gui.Icon("chevron-right")<span class="w-card__title">{ gui.T(ctx, "users.form.rights") }</span></summary>
			<div class="w-card__body">
				<fieldset class="w-fieldset w-fieldset--wide">
					<legend class="visually-hidden">{ gui.T(ctx, "users.form.rights") }</legend>
					@rightsChecks(d)
				</fieldset>
			</div>
		</details>
		@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Required: true, Title: d.Title})
	</form>
}

// deleteView: confirmation page of the deletion of a user (decision D10: a
// page, not a dialog). The title names the user, the text says the
// consequence, the rights are recalled, "Cancel" then "Delete" bottom right
// (D12). Refused (the signed-in user's own account, the last administrator):
// the cause, no "Delete" button.
templ deleteView(d deleteData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ gui.T(ctx, "users.delete.title", "name", d.Name) }</h1>
		</div>
		<div class="w-page-header__actions">
			<a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>
				@gui.Icon("arrow-left")
				{ gui.T(ctx, "users.back_user") }
			</a>
		</div>
	</div>
	<div class="w-card">
		if d.Blocked {
			@gui.Banner(gui.BannerProps{Kind: "ko", Title: gui.T(ctx, "users.delete.blocked_title"), Text: " " + d.BlockedText})
		} else {
			<p class="users-lead">{ gui.T(ctx, "users.delete.text") }</p>
		}
		<dl class={ "w-deflist", templ.KV("users-deflist", d.Blocked) }>
			<dt>{ gui.T(ctx, "users.detail.login") }</dt>
			<dd><code class="w-code">{ d.Name }</code></dd>
		</dl>
		<h2 class="w-card__title users-subtitle">{ gui.T(ctx, "users.detail.rights") }</h2>
		@rights.List(d.Caption, d.Rights)
		if d.Blocked {
			<div class="w-form__actions users-form-actions"><a class="w-btn w-btn--outline-dark" href={ templ.SafeURL(d.CancelURL) }>{ gui.T(ctx, "users.back_user") }</a></div>
		} else {
			<form class="users-form-actions" method="post" action={ templ.SafeURL(d.Action) }>@gui.FormActions(gui.FormActionsProps{CancelURL: d.CancelURL, Danger: true, Title: gui.T(ctx, "users.delete.title", "name", d.Name)})</form>
		}
	</div>
}

// notFoundView: a user that does not exist: localised 404 in the chrome,
// with the way back to the list as the user left it.
templ notFoundView(d notFoundData) {
	<div class="w-page-header">
		<div class="w-page-header__text">
			<h1 class="w-page-header__title">{ d.Title }</h1>
		</div>
	</div>
	@gui.Empty(gui.EmptyProps{Icon: "users", Title: d.Text, Action: &gui.Link{Label: d.BackLabel, URL: d.BackURL, Icon: "arrow-left"}})
}
